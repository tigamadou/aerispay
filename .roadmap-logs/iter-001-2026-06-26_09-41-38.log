      Magasin  @relation(fields: [magasinId], references: [id])\n\n  @@index([organisationId])\n  @@index([magasinId, caisseId])\n  @@map(\"sessions_cloud\")\n}\n","structuredPatch":[],"originalFile":null,"userModified":false}}
