{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011cFwiH82SwLsAFoQ2sJLeJ","type":"tool_result","content":"1\t/**\n2\t * Thermal printer & cash drawer abstraction.\n3\t * Uses environment variables for configuration.\n4\t * Falls back gracefully when printer is disabled or unreachable.\n5\t */\n6\t\n7\texport interface PrinterConfig {\n8\t  enabled: boolean;\n9\t  type: \"EPSON\" | \"STAR\";\n10\t  interface: string;\n11\t  width: 48 | 32;\n12\t}\n13\t\n14\texport interface CashDrawerConfig {\n15\t  enabled: boolean;\n16\t  mode: \"printer\" | \"direct\";\n17\t  pin: 2 | 5;\n18\t  openOnCash: boolean;\n19\t}\n20\t\n21\texport function getPrinterConfig(): PrinterConfig {\n22\t  return {\n23\t    enabled: process.env.PRINTER_ENABLED === \"true\",\n24\t    type: (process.env.PRINTER_TYPE as \"EPSON\" | \"STAR\") ?? \"EPSON\",\n25\t    interface: process.env.PRINTER_INTERFACE ?? \"tcp://127.0.0.1:9100\",\n26\t    width: parseInt(process.env.PRINTER_WIDTH ?? \"48\") === 32 ? 32 : 48,\n27\t  };\n28\t}\n29\t\n30\texport function getCashDrawerConfig(): CashDrawerConfig {\n31\t  return {\n32\t    enabled: process.env.CASH_DRAWER_ENABLED === \"true\",\n33\t    mode: (process.env.CASH_DRAWER_MODE as \"printer\" | \"direct\") ?? \"printer\",\n34\t    pin: parseInt(process.env.CASH_DRAWER_PIN ?? \"2\") === 5 ? 5 : 2,\n35\t    openOnCash: process.env.CASH_DRAWER_OPEN_ON_CASH !== \"false\",\n36\t  };\n37\t}\n38\t\n39\texport interface PrintResult {\n40\t  success: boolean;\n41\t  message: string;\n42\t}\n43\t\n44\texport async function printReceipt(\n45\t  _venteId: string,\n46\t  config?: Partial<PrinterConfig>\n47\t): Promise<PrintResult> {\n48\t  const printerConfig = { ...getPrinterConfig(), ...config };\n49\t\n50\t  if (!printerConfig.enabled) {\n51\t    return { success: false, message: \"Imprimante désactivée (PRINTER_ENABLED=false)\" };\n52\t  }\n53\t\n54\t  try {\n55\t    // Dynamic import to avoid errors when node-thermal-printer is not installed\n56\t    const { ThermalPrinter, PrinterTypes } = await import(\"node-thermal-printer\");\n57\t\n58\t    const printer = new ThermalPrinter({\n59\t      type: PrinterTypes[printerConfig.type],\n60\t      interface: printerConfig.interface,\n61\t      width: printerConfig.width,\n62\t    });\n63\t\n64\t    const isConnected = await printer.isPrinterConnected();\n65\t    if (!isConnected) {\n66\t      return { success: false, message: \"Imprimante non joignable\" };\n67\t    }\n68\t\n69\t    // TODO: Build receipt content from vente data\n70\t    // For now, this is a stub that will be completed when PDF generation is implemented\n71\t    await printer.execute();\n72\t\n73\t    return { success: true, message: \"Ticket envoyé à l'imprimante\" };\n74\t  } catch (error) {\n75\t    const msg = error instanceof Error ? error.message : \"Erreur inconnue\";\n76\t    return { success: false, message: `Erreur imprimante : ${msg}` };\n77\t  }\n78\t}\n79\t\n80\texport async function openCashDrawer(\n81\t  config?: Partial<CashDrawerConfig>\n82\t): Promise<PrintResult> {\n83\t  const drawerConfig = { ...getCashDrawerConfig(), ...config };\n84\t\n85\t  if (!drawerConfig.enabled) {\n86\t    return { success: false, message: \"Tiroir-caisse désactivé (CASH_DRAWER_ENABLED=false)\" };\n87\t  }\n88\t\n89\t  try {\n90\t    const { ThermalPrinter, PrinterTypes } = await import(\"node-thermal-printer\");\n91\t    const printerConfig = getPrinterConfig();\n92\t\n93\t    const printer = new ThermalPrinter({\n94\t      type: PrinterTypes[printerConfig.type],\n95\t      interface: printerConfig.interface,\n96\t    });\n97\t\n98\t    const isConnected = await printer.isPrinterConnected();\n99\t    if (!isConnected) {\n100\t      return { success: false, message: \"Tiroir-caisse non joignable\" };\n101\t    }\n102\t\n103\t    await printer.openCashDrawer();\n104\t    await printer.execute();\n105\t\n106\t    return { success: true, message: \"Tiroir-caisse ouvert\" };\n107\t  } catch (error) {\n108\t    const msg = error instanceof Error ? error.message : \"Erreur inconnue\";\n109\t    return { success: false, message: `Erreur tiroir-caisse : ${msg}` };\n110\t  }\n111\t}\n112\t"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"d9552528-38ba-451f-aab2-8372d25ab64b","timestamp":"2026-06-26T08:42:13.669Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/lib/receipt/thermal-printer.ts","content":"/**\n * Thermal printer & cash drawer abstraction.\n * Uses environment variables for configuration.\n * Falls back gracefully when printer is disabled or unreachable.\n */\n\nexport interface PrinterConfig {\n  enabled: boolean;\n  type: \"EPSON\" | \"STAR\";\n  interface: string;\n  width: 48 | 32;\n}\n\nexport interface CashDrawerConfig {\n  enabled: boolean;\n  mode: \"printer\" | \"direct\";\n  pin: 2 | 5;\n  openOnCash: boolean;\n}\n\nexport function getPrinterConfig(): PrinterConfig {\n  return {\n    enabled: process.env.PRINTER_ENABLED === \"true\",\n    type: (process.env.PRINTER_TYPE as \"EPSON\" | \"STAR\") ?? \"EPSON\",\n    interface: process.env.PRINTER_INTERFACE ?? \"tcp://127.0.0.1:9100\",\n    width: parseInt(process.env.PRINTER_WIDTH ?? \"48\") === 32 ? 32 : 48,\n  };\n}\n\nexport function getCashDrawerConfig(): CashDrawerConfig {\n  return {\n    enabled: process.env.CASH_DRAWER_ENABLED === \"true\",\n    mode: (process.env.CASH_DRAWER_MODE as \"printer\" | \"direct\") ?? \"printer\",\n    pin: parseInt(process.env.CASH_DRAWER_PIN ?? \"2\") === 5 ? 5 : 2,\n    openOnCash: process.env.CASH_DRAWER_OPEN_ON_CASH !== \"false\",\n  };\n}\n\nexport interface PrintResult {\n  success: boolean;\n  message: string;\n}\n\nexport async function printReceipt(\n  _venteId: string,\n  config?: Partial<PrinterConfig>\n): Promise<PrintResult> {\n  const printerConfig = { ...getPrinterConfig(), ...config };\n\n  if (!printerConfig.enabled) {\n    return { success: false, message: \"Imprimante désactivée (PRINTER_ENABLED=false)\" };\n  }\n\n  try {\n    // Dynamic import to avoid errors when node-thermal-printer is not installed\n    const { ThermalPrinter, PrinterTypes } = await import(\"node-thermal-printer\");\n\n    const printer = new ThermalPrinter({\n      type: PrinterTypes[printerConfig.type],\n      interface: printerConfig.interface,\n      width: printerConfig.width,\n    });\n\n    const isConnected = await printer.isPrinterConnected();\n    if (!isConnected) {\n      return { success: false, message: \"Imprimante non joignable\" };\n    }\n\n    // TODO: Build receipt content from vente data\n    // For now, this is a stub that will be completed when PDF generation is implemented\n    await printer.execute();\n\n    return { success: true, message: \"Ticket envoyé à l'imprimante\" };\n  } catch (error) {\n    const msg = error instanceof Error ? error.message : \"Erreur inconnue\";\n    return { success: false, message: `Erreur imprimante : ${msg}` };\n  }\n}\n\nexport async function openCashDrawer(\n  config?: Partial<CashDrawerConfig>\n): Promise<PrintResult> {\n  const drawerConfig = { ...getCashDrawerConfig(), ...config };\n\n  if (!drawerConfig.enabled) {\n    return { success: false, message: \"Tiroir-caisse désactivé (CASH_DRAWER_ENABLED=false)\" };\n  }\n\n  try {\n    const { ThermalPrinter, PrinterTypes } = await import(\"node-thermal-printer\");\n    const printerConfig = getPrinterConfig();\n\n    const printer = new ThermalPrinter({\n      type: PrinterTypes[printerConfig.type],\n      interface: printerConfig.interface,\n    });\n\n    const isConnected = await printer.isPrinterConnected();\n    if (!isConnected) {\n      return { success: false, message: \"Tiroir-caisse non joignable\" };\n    }\n\n    await printer.openCashDrawer();\n    await printer.execute();\n\n    return { success: true, message: \"Tiroir-caisse ouvert\" };\n  } catch (error) {\n    const msg = error instanceof Error ? error.message : \"Erreur inconnue\";\n    return { success: false, message: `Erreur tiroir-caisse : ${msg}` };\n  }\n}\n","numLines":112,"startLine":1,"totalLines":112}}}
