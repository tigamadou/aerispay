{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_011X5P6cehtGsNtFMXZUgXxL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01G5Q9FJytGGqzaazoaJvjm2","name":"Write","input":{"file_path":"/Users/amadou/Devs/projects/aerispay/web/app/src/__tests__/security/health-api.test.ts","content":"/**\n * C2.3 — Health-check du nœud magasin.\n * Le client Electron interroge cet endpoint ; s'il échoue, il affiche un écran de\n * blocage (pas de mode dégradé, ADR-001). Endpoint public léger : statut + connectivité DB.\n */\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.mock(\"@/lib/db\", () => ({\n  prisma: { $queryRaw: vi.fn() },\n}));\n\nimport { prisma } from \"@/lib/db\";\n\ndescribe(\"GET /api/health\", () => {\n  let GET: () => Promise<Response>;\n\n  beforeEach(async () => {\n    vi.clearAllMocks();\n    GET = (await import(\"@/app/api/health/route\")).GET;\n  });\n\n  it(\"renvoie 200 + status ok quand la base répond\", async () => {\n    (prisma.$queryRaw as ReturnType<typeof vi.fn>).mockResolvedValue([{ \"1\": 1 }]);\n    const res = await GET();\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe(\"ok\");\n    expect(body.db).toBe(true);\n  });\n\n  it(\"renvoie 503 quand la base est injoignable\", async () => {\n    (prisma.$queryRaw as ReturnType<typeof vi.fn>).mockRejectedValue(new Error(\"DB down\"));\n    const res = await GET();\n    expect(res.status).toBe(503);\n    const body = await res.json();\n    expect(body.status).toBe(\"unavailable\");\n    expect(body.db).toBe(false);\n  });\n});\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":410,"cache_read_input_tokens":447564,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":410},"output_tokens":6,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"c2487fd3-9bfc-49a9-82a0-e0bc33f28546","request_id":"req_011CcRanLHWzzHKr99WcuCg3"}
