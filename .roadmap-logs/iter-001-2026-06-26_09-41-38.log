prisma.vente.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue(null);\n57\t    const res = await POST(\n58\t      new Request(\"http://localhost\", { method: \"POST\" }),\n59\t      { params: Promise.resolve({ id: \"v-999\" }) }\n60\t    );\n61\t    expect(res.status).toBe(404);\n62\t  });\n63\t\n64\t  it(\"returns 200 on successful print\", async () => {\n65\t    mockSession(\"CAISSIER\");\n66\t    (prisma.vente.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({ id: \"v-1\" });\n67\t    const { printReceipt } = await import(\"@/lib/receipt/thermal-printer\");\n68\t    (printReceipt as ReturnType<typeof vi.fn>).mockResolvedValue({ success: true, message: \"OK\" });\n69\t\n70\t    const res = await POST(\n71\t      new Request(\"http://localhost\", { method: \"POST\" }),\n72\t      { params: Promise.resolve({ id: \"v-1\" }) }\n73\t    );\n74\t    expect(res.status).toBe(200);\n75\t  });\n76\t\n77\t  it(\"returns 503 on printer failure\", async () => {\n78\t    mockSession(\"CAISSIER\");\n79\t    (prisma.vente.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({ id: \"v-1\" });\n80\t    const { printReceipt } = await import(\"@/lib/receipt/thermal-printer\");\n81\t    (printReceipt as ReturnType<typeof vi.fn>).mockResolvedValue({ success: false, message: \"Offline\" });\n82\t\n83\t    const res = await POST(\n84\t      new Request(\"http://localhost\", { method: \"POST\" }),\n85\t      { params: Promise.resolve({ id: \"v-1\" }) }\n86\t    );\n87\t    expect(res.status).toBe(503);\n88\t  });\n89\t\n90\t  it(\"returns 500 on unexpected error\", async () => {\n91\t    mockSession(\"CAISSIER\");\n92\t    (prisma.vente.findUnique as ReturnType<typeof vi.fn>).mockRejectedValue(new Error(\"DB\"));\n93\t    const res = await POST(\n94\t      new Request(\"http://localhost\", { method: \"POST\" }),\n95\t      { params: Promise.resolve({ id: \"v-1\" }) }"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"a19e21e1-e1