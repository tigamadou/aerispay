ForSession should have been called\n112\t    expect(computeHashForSession).toHaveBeenCalled();\n113\t    // The hash update should happen inside the transaction\n114\t    expect(transactionUpdateCalled).toBe(true);\n115\t  });\n116\t});\n117\t\n118\tdescribe(\"P0-005 (bis): caisseId validation in correct route\", () => {\n119\t  let POST: (req: Request, ctx: { params: Promise<{ id: string }> }) => Promise<Response>;\n120\t\n121\t  beforeEach(async () => {\n122\t    vi.clearAllMocks();\n123\t    POST = (await import(\"@/app/api/comptoir/sessions/[id]/correct/route\")).POST;\n124\t    (prisma.user.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({ motDePasse: \"hashed\" });\n125\t  });\n126\t\n127\t  it(\"returns 422 when no active caisse exists\", async () => {\n128\t    mockUser(\"ADMIN\");\n129\t\n130\t    (prisma.comptoirSession.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({\n131\t      id: \"s-1\", statut: \"VALIDEE\", userId: \"user-1\", sessionCorrective: null,\n132\t    });\n133\t    (prisma.caisse.findFirst as ReturnType<typeof vi.fn>).mockResolvedValue(null);\n134\t\n135\t    const res = await POST(jsonReq(validBody), ctx);\n136\t    expect(res.status).toBe(422);\n137\t    const body = await res.json();\n138\t    expect(body.error).toMatch(/caisse/i);\n139\t  });\n140\t});"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"afa714de-6820-4613-9329-7b016796d376","timestamp":"2026-06-26T04:26:02.287Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/__tests__/caisse/correct-hash-integrity.test.ts","content":"describe(\"P1-002: Hash integrity inside transaction\", () => {\n  let POST: (req: Request, ctx: { params: Promise<{ id: string }> }) => Promise<Response>;\n\n  beforeEach(async () => {\n    vi.clearAllMocks();\n    POST = (await import(\"@/app/api/comptoir/sessions/[id]/correct/route\")).POST;\n    (prisma.caisse.findFirst as ReturnType<typeof vi.fn>).mockResolvedValue({ id: \"caisse-1\" });\n    (prisma.user.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({ motDePasse: \"hashed\" });\n  });\n\n  it(\"corrective session always has hashIntegrite non-null\", async () => {\n    mockUser(\"ADMIN\");\n\n    (prisma.comptoirSession.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({\n      id: \"s-1\", statut: \"VALIDEE\", userId: \"user-1\", sessionCorrective: null,\n    });\n\n    let transactionUpdateCalled = false;\n    const correctiveSession = {\n      id: \"s-corrective\", statut: \"VALIDEE\", fermetureAt: new Date(),\n      montantOuvertureCash: 0, montantOuvertureMobileMoney: 0,\n      userId: \"admin-1\", sessionCorrigeeId: \"s-1\",\n    };\n\n    (prisma.$transaction as ReturnType<typeof vi.fn>).mockImplementation(async (fn: Function) => {\n      const tx = {\n        comptoirSession: {\n          create: vi.fn().mockResolvedValue(correctiveSession),\n          update: vi.fn().mockImplementation(async () => {\n            transactionUpdateCalled = true;\n          }),\n        },\n      };\n      return fn(tx);\n    });\n\n    const res = await POST(jsonReq(validBody), ctx);\n    expect(res.status).toBe(201);\n    const body = await res.json();\n\n    // Hash should be set\n    expect(body.data.hash).toBeTruthy();\n    // computeHashForSession should have been called\n    expect(computeHashForSession).toHaveBeenCalled();\n    // The hash update should happen inside the transaction\n    expect(transactionUpdateCalled).toBe(true);\n  });\n});\n\ndescribe(\"P0-005 (bis): caisseId validation in correct route\", () => {\n  let POST: (req: Request, ctx: { params: Promise<{ id: string }> }) => Promise<Response>;\n\n  beforeEach(async () => {\n    vi.clearAllMocks();\n    POST = (await import(\"@/app/api/comptoir/sessions/[id]/correct/route\")).POST;\n    (prisma.user.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({ motDePasse: \"hashed\" });\n  });\n\n  it(\"returns 422 when no 