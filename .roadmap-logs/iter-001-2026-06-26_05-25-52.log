ntUserAgent(_req),\n128\t    });\n129\t\n130\t    return Response.json({ data: updated });\n131\t  } catch (error) {\n132\t    console.error(`[POST /api/ventes/${id}/annuler]`, error);\n133\t    return Response.json({ error: \"Erreur serveur\" }, { status: 500 });\n134\t  }\n135\t}\n136\t"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"0fda7cb9-83a9-48cc-9837-bef1e58775a0","timestamp":"2026-06-26T04:28:32.683Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/app/api/ventes/[id]/annuler/route.ts","content":"            produitId: ligne.produitId,\n            venteId: vente.id,\n          },\n        });\n      }\n\n      // P0-002: RULE-MVT-003 : mouvement REMBOURSEMENT (négatif) par paiement\n      // Cap each refund to the sale total (like POST /api/ventes L234-255)\n      const totalNum = Number(vente.total);\n      let remainingTotal = totalNum;\n      for (const paiement of cancelled.paiements) {\n        const paiementMontant = Math.min(Math.abs(Number(paiement.montant)), remainingTotal);\n        if (paiementMontant > 0) {\n          await createMovementInTx(tx, {\n            type: \"REMBOURSEMENT\",\n            mode: paiement.mode,\n            montant: -paiementMontant,\n            caisseId,\n            sessionId: vente.sessionId,\n            auteurId: result.user.id,\n            venteId: vente.id,\n            motif: `Annulation vente ${vente.numero}`,\n            reference: paiement.reference ?? undefined,\n          });\n          remainingTotal -= paiementMontant;\n        }\n      }\n\n      return cancelled;\n    });\n\n    await logActivity({\n      action: ACTIONS.SALE_CANCELLED,\n      actorId: result.user.id,\n      entityType: \"Sale\",\n      entityId: id,\n      metadata: {\n        numero: vente.numero,\n        total: Number(vente.total),\n        sousTotal: Number(vente.sousTotal),\n        remise: Number(vente.remise),\n        tva: Number