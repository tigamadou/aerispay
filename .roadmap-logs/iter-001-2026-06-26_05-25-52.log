e, ecart, categorie } }\n156\t  ecartsParMode Json?\n157\t\n158\t  // Intégrité\n159\t  hashIntegrite         String? @db.VarChar(64)\n160\t  hashSessionPrecedente String? @db.VarChar(64)\n161\t\n162\t  // Recomptage / contestation\n163\t  tentativesRecomptage Int @default(0)\n164\t\n165\t  // Force-close\n166\t  motifForceClose String? @db.Text\n167\t\n168\t  // Lot G — RULE-FOND-004 : imputation d'un écart d'ouverture à la session précédente\n169\t  ecartOuvertureImputeSessionId String?\n170\t\n171\t  statut StatutSession @default(OUVERTE)\n172\t  notes  String?\n173\t\n174\t  // Relations\n175\t  userId     String\n176\t  user       User    @relation(fields: [userId], references: [id])\n177\t  valideurId String?\n178\t  valideur   User?   @relation(\"SessionValideur\", fields: [valideurId], references: [id])\n179\t\n180\t  ventes           Vente[]\n181\t  mouvementsCaisse MouvementCaisse[]\n182\t\n183\t  // Session corrective : cette session corrige une session originale\n184\t  sessionCorrigeeId String?          @unique\n185\t  sessionCorrigee   ComptoirSession? @relation(\"SessionCorrective\", fields: [sessionCorrigeeId], references: [id])\n186\t  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n187\t\n188\t  @@map(\"comptoir_sessions\")\n189\t}\n190\t\n191\tenum StatutSession {\n192\t  OUVERTE\n193\t  FERMEE // conservé pour rétrocompatibilité données existantes\n194\t  EN_ATTENTE_CLOTURE\n195\t  EN_ATTENTE_VALIDATION\n196\t  VALIDEE\n197\t  CONTESTEE\n198\t  FORCEE\n199\t  CORRIGEE\n200\t}\n201\t\n202\t// ─── MODULE CAISSE — MOUVEMENTS ─────────────────────\n203\t\n204\tmodel MouvementCaisse {\n205\t  id           String              @id @default(cuid())\n206\t  type         TypeMouvementCaisse\n207\t  mode         String\n208\t  montant      Decimal             @db.Decimal(10, 2)\n209\t  motif        String?\n210\t  reference    String?\n211\t  justificatif String?             @db.Text\n212\t  offline      Boolean             @default(false)\n213\t  createdAt    DateTime            @default(now())\n214\t\n215\t  caisseId  String\n216\t  caisse    Caisse          @relation(fields: [caisseId], references: [id])\n217\t  sessionId String?\n218\t  session   ComptoirSession? @relation(fields: [sessionId], references: [id])\n219\t  venteId   String?\n220\t  vente     Vente?           @relation(fields: [venteId], references: [id])\n221\t  auteurId  String\n222\t  auteur    User             @relation(\"MouvementCaisseAuteur\", fields: [auteurId], references: [id])\n223\t\n224\t  @@index([caisseId])\n225\t  @@index([sessionId])"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"9966a747-fe4c-4f7f-93c0-522521c0579d","timestamp":"2026-06-26T04:32:11.795Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/prisma/schema.prisma","content":"// ─── MODULE CAISSE ────────────────────────────────────\n\nmodel Caisse {\n  id        String   @id @default(cuid())\n  nom       String\n  active    Boolean  @default(true)\n  createdAt DateTime @default(now())\n\n  mouvements MouvementCaisse[]\n\n  @@map(\"caisses\")\n}\n\n// ─── MODULE COMPTOIR / SESSIONS ──────────────────────\n\nmodel ComptoirSession {\n  id          String    @id @default(cuid())\n  ouvertureAt DateTime  @default(now())\n  fermetureAt DateTime?\n\n  // Montants declares a l'ouverture (snapshot de ce que le caissier compte)\n  montantOuvertureCash        Decimal @db.Decimal(10, 2)\n  montantOuvertureMobileMoney Decimal @default(0) @db.Decimal(10, 2)\n\n  // Déclarations caissier (étape 1 de clôture) — JSON { mode: montant }\n  declarationsCaissier Json?\n  demandeCloturAt      DateTime?\n\n  // Déclarations ouverture par mode — JSON { mode: montant }\n  declarationsOuverture Json?\n  // Écarts ouverture par mode — JSON [{ mode, theorique, declare, ecart, categorie }]\n  ecartsOuverture       Json?\n\n  // Déclarations valideur (étape 3 — validation à l'aveugle) — JSON { mode: montant }\n  declarationsValideur Json?\n\n  // Résultats fermeture (conservés pour rétrocompatibilité MVP)\n  montantFermetureCash        Decimal? @db.Decimal(10, 2)\n  montantFermetureMobileMoney Decimal? @db.Decimal(10, 2)\n  soldeTheoriqueCash          Decimal? @db.Decimal(10, 2)\n  soldeTheoriqueMobileMoney   Decimal? @db.Decimal(10, 2)\n  ecartCash                   Decimal? @db.Decimal(10, 2)\n  ecartMobileMoney            Decimal? @db.Decimal(10, 2)\n\n  // Écarts finaux par mode — JSON { mode: { theorique, declare, ecart, categorie } }\n  ecartsParMode Json?\n\n  // Intégrité\n  hashIntegrite         String? @db.VarChar(64)\n  hashSessionPrecedente String? @db.VarChar(64)\n\n  // Recomptage / contestation\n  tentativesRecomptage Int @default(0)\n\n  // Force-close\n  motifForceClose String? @db.Text\n\n  // Lot G — RULE-FOND-004 : imputation d'un écart d'ouverture à la session précédente\n  ecartOuvertureImputeSessionId String?\n\n  statut StatutSession @default(OUVERTE)\n  notes  String?\n\n  // Relations\n  userId     String\n  user       User    @relation(fields: [userId], references: [id])\n  valideurId String?\n  valideur   User?   @relation(\"SessionValideur\", fields: [valideurId], references: [id])\n\n  ventes           Vente[]\n  mouvementsCaisse MouvementCaisse[]\n\n  // Session corrective : cette session corrige une session originale\n  sessionCorrigeeId String?          @unique\n  sessionCorrigee   ComptoirSession? @relation(\"SessionCorrective\", fields: [sessionCorrigeeId], references: [id])\n  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n\n  @@map(\"comptoir_sessions\")\n}\n\nenum StatutSession {\n  OUVERTE\n  FERMEE // conservé pour rétrocompatibilité données existantes\n  EN_ATTENTE_CLOTURE\n  EN_ATTENTE_VALIDATION\n  VALIDEE\n  CONTESTEE\n  FORCEE\n  CORRIGEE\n}\n\n// ─── MODULE CAISSE — MOUVEMENTS ─────────────────────\n\nmodel MouvementCaisse {\n  id           String              @id @default(cuid())\n  type         TypeMouvementCaisse\n  mode         String\n  montant      Decimal             @db.Decimal(10, 2)\n  motif        String?\n  reference    String?\n  justificatif String?             @db.Text\n  offline      Boolean             @default(false)\n  createdAt    DateTime            @default(now())\n\n  caisseId  String\n  caisse    Caisse          @relation(fields: [caisseId], references: [id])\n  sessionId String?\n  session   ComptoirSession? @relation(fields: [sessionId], references: [id])\n  venteId   String?\n  vente     Vente?           @relation(fields: [venteId], references: [id])\n  auteurId  String\n  auteur    User             @relation(\"MouvementCaisseAuteur\", fields: [auteurId], references: [id])\n\n  @@index([caisseId])\n  @@index([sessionId])","numLines":115,"startLine":111,"totalLines":417}}}
