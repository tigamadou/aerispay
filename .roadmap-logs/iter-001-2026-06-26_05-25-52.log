6\t            const lineSubtotal = new Prisma.Decimal(l.prixUnitaire)\n137\t              .mul(l.quantite)\n138\t              .mul(new Prisma.Decimal(1).sub(new Prisma.Decimal(l.remise).div(100)));\n139\t            sousTotal = sousTotal.add(lineSubtotal);\n140\t            return {\n141\t              quantite: l.quantite,\n142\t              prixUnitaire: l.prixUnitaire,\n143\t              remise: l.remise,\n144\t              tva: 0,\n145\t              sousTotal: lineSubtotal,\n146\t              produitId: p.id,\n147\t            };\n148\t          });\n149\t\n150\t          const montantRemise = new Prisma.Decimal(remise);\n151\t          const base = sousTotal.sub(montantRemise);\n152\t\n153\t          // Compute each tax on the base (sous-total - remise)\n154\t          const taxesDetail: { nom: string; taux: number; montant: number }[] = [];\n155\t          let totalTva = new Prisma.Decimal(0);\n156\t          if (base.gt(0)) {\n157\t            for (const t of activeTaxes) {\n158\t              const montant = base.mul(new Prisma.Decimal(t.taux).div(100)).round();\n159\t              taxesDetail.push({ nom: t.nom, taux: Number(t.taux), montant: Number(montant) });\n160\t              totalTva = totalTva.add(montant);\n161\t            }\n162\t          }\n163\t\n164\t          const total = sousTotal.sub(montantRemise).add(totalTva);\n165\t\n166\t          // P1-001: Sale total must be positive\n167\t          if (total.lte(0)) {\n168\t            throw new TxError(\"Le total de la vente doit etre positif\", 422);\n169\t          }\n170\t\n171\t          // Check payments cover total\n172\t          const totalPaiements = paiements.reduce(\n173\t            (sum, p) => sum.add(new Prisma.Decimal(p.montant)),\n174\t            new Prisma.Decimal(0)\n175\t          );\n176\t          if (totalPaiements.lt(total)) {\n177\t            throw new TxError(\n178\t              `Paiement insuffisant (total: ${total.toFixed(0)}, reçu: ${totalPaiements.toFixed(0)}