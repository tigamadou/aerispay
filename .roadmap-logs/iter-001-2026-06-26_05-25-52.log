{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HW6WCsuCt24fWXu219VdG3","type":"tool_result","content":"56\t\n57\t    const { declarations, confirmeEcart } = parsed.data;\n58\t\n59\t    // Verifier qu'une caisse active existe et a un solde > 0\n60\t    const caisse = await prisma.caisse.findFirst({ where: { active: true }, select: { id: true } });\n61\t    if (!caisse) {\n62\t      return Response.json(\n63\t        { error: \"Aucune caisse active configuree\" },\n64\t        { status: 422 },\n65\t      );\n66\t    }\n67\t\n68\t    const soldes = await computeSoldeCaisseParMode(caisse.id);\n69\t    const soldeTotal = soldes.reduce((sum: number, s: { solde: number }) => sum + s.solde, 0);\n70\t    if (soldeTotal <= 0) {\n71\t      return Response.json(\n72\t        { error: \"Impossible d'ouvrir une session : le solde de la caisse est a zero. Effectuez un apport de fonds d'abord.\" },\n73\t        { status: 422 },\n74\t      );\n75\t    }\n76\t\n77\t    // Build solde map from grand livre\n78\t    const soldeMap = new Map<string, number>();\n79\t    for (const s of soldes) {\n80\t      soldeMap.set(s.mode, s.solde);\n81\t    }\n82\t\n83\t    // RULE-FOND-004 / RULE-SEUIL-001 : catégorisation via seuils paramétrables (zéro valeur en dur),\n84\t    // mêmes bornes (MINEUR + MEDIUM) que la réconciliation.\n85\t    const seuilMineur = await getSeuil(\"THRESHOLD_DISCREPANCY_MINOR\");\n86\t    const seuilMajeur = await getSeuil(\"THRESHOLD_DISCREPANCY_MEDIUM\");\n87\t\n88\t    // Compare each declared mode to the grand livre\n89\t    const allModes = new Set([...Object.keys(declarations), ...soldeMap.keys()]);\n90\t    const ecarts: EcartOuverture[] = [];\n91\t    for (const mode of allModes) {\n92\t      const theorique = soldeMap.get(mode) ?? 0;\n93\t      const declare = declarations[mode] ?? 0;\n94\t      const ecart = declare - theorique;\n95\t      if (Math.abs(ecart) > 0.01) {\n96\t        ecarts.push({\n97\t          mode,\n98\t          theorique,\n99\t          declare,\n100\t          ecart,\n101\t          // categorizeDiscrepancy ne renvoie null que pour ecart == 0 (exclu ici)\n102\t          categorie: categorizeDiscrepancy(ecart, seuilMineur, seuilMajeur) ?? \"MINEUR\",\n103\t        });\n104\t      }\n105\t    }\n106\t\n107\t    const hasEcarts = ecarts.length > 0;\n108\t\n109\t    // If ecarts exist and not confirmed, return 409\n110\t    if (hasEcarts && !confirmeEcart) {\n111\t      const ecartsRecord: Record<string, { theorique: number; declare: number; ecart: number; categorie: string }> = {};\n112\t      for (const e of ecarts) {\n113\t        ecartsRecord[e.mode] = {\n114\t          theorique: e.theorique,\n115\t          declare: e.declare,\n116\t          ecart: e.ecart,\n117\t          categorie: e.categorie,\n118\t        };\n119\t      }\n120\t      return Response.json(\n121\t        {\n122\t          requiresConfirmation: true,\n123\t          message: \"Le montant declare differe du solde de la caisse. Confirmez-vous l'ouverture ?\",\n124\t          ecarts: ecartsRecord,\n125\t        },\n126\t        { status: 409 },\n127\t      );\n128\t    }\n129\t\n130\t    // Retrocompat: compute legacy fields from declarations\n131\t    const montantOuvertureCash = declarations[\"ESPECES\"] ?? 0;\n132\t    const montantOuvertureMobileMoney = Object.entries(declarations)\n133\t      .filter(([mode]) => mode !== \"ESPECES\")\n134\t      .reduce((sum, [, val]) => sum + val, 0);\n135\t\n136\t    // RULE-FOND-004 : un écart d'ouverture est imputé à la session précédente finalisée\n137\t    const sessionPrecedente = hasEcarts\n138\t      ? await prisma.comptoirSession.findFirst({\n139\t          where: { statut: { in: [\"VALIDEE\", \"FORCEE\", \"CORRIGEE\", \"FERMEE\"] } },\n140\t          orderBy: { ouvertureAt: \"desc\" },\n141\t          select: { id: true },\n142\t        })\n143\t      : null;\n144\t\n145\t    // Lot C (RULE-CAISSE-002, Option A — tiroir partagé séquentiel) :\n146\t    //