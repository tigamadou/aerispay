ll\", async () => {\n87\t    (prisma.comptoirSession.findUniqueOrThrow as ReturnType<typeof vi.fn>).mockResolvedValue({\n88\t      ...fakeSession,\n89\t      ecartsParMode: null,\n90\t    });\n91\t    (prisma.mouvementCaisse.findMany as ReturnType<typeof vi.fn>).mockResolvedValue(fakeMovements);\n92\t    (prisma.comptoirSession.findFirst as ReturnType<typeof vi.fn>).mockResolvedValue(null);\n93\t\n94\t    const hash = await computeHashForSession(\"s-1\", fermetureAt);\n95\t    expect(hash).toMatch(/^[a-f0-9]{64}$/);\n96\t  });\n97\t});\n98\t\n99\tdescribe(\"verifySessionIntegrity\", () => {\n100\t  beforeEach(() => {\n101\t    vi.clearAllMocks();\n102\t  });\n103\t\n104\t  it(\"renvoie valid:true quand les hashes correspondent\", async () => {\n105\t    // Compute expected hash first\n106\t    const expectedHash = computeSessionHash({\n107\t      sessionId: \"s-1\",\n108\t      userId: \"u-1\",\n109\t      ouvertureAt: ouvertureAt.toISOString(),\n110\t      validationAt: fermetureAt.toISOString(),\n111\t      mouvements: fakeMovements.map((m) => ({\n112\t        id: m.id,\n113\t        type: m.type,\n114\t        montant: String(m.montant),\n115\t        mode: m.mode,\n116\t        createdAt: m.createdAt.toISOString(),\n117\t      })),\n118\t      declarationsCaissier: { ESPECES: 60000 },\n119\t      declarationsValideur: { ESPECES: 60000 },\n120\t      ecarts: { ESPECES: 0 },\n121\t      hashPrecedent: \"\",\n122\t    });\n123\t\n124\t    // Mock findUniqueOrThrow for verifySessionIntegrity (first call: get hash + fermetureAt)\n125\t    (prisma.comptoirSession.findUniqueOrThrow as ReturnType<typeof vi.fn>)\n126\t      .mockResolvedValueOnce({ hashIntegrite: expectedHash, fermetureAt })\n127\t      .mockResolvedValueOnce(fakeSession);\n128\t    (prisma.mouvementCaisse.findMany as ReturnType<typeof vi.fn>).mockResolvedValue(fakeMovements);\n129\t    (prisma.comptoirSession.findFirst as ReturnType<typeof vi.fn>).mockResolvedValue(null);\n130\t\n131\t    const result =