{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MeJezrvviBvjchRZ9Vbj25","type":"tool_result","content":"1\timport { createHash } from \"crypto\";\n2\timport { prisma } from \"@/lib/db\";\n3\t\n4\tinterface HashInput {\n5\t  sessionId: string;\n6\t  userId: string;\n7\t  ouvertureAt: string; // ISO 8601\n8\t  validationAt: string; // ISO 8601\n9\t  mouvements: Array<{\n10\t    id: string;\n11\t    type: string;\n12\t    montant: string;\n13\t    mode: string;\n14\t    createdAt: string;\n15\t  }>;\n16\t  declarationsCaissier: Record<string, number>;\n17\t  declarationsValideur: Record<string, number> | null;\n18\t  ecarts: Record<string, number>;\n19\t  hashPrecedent: string;\n20\t}\n21\t\n22\t/**\n23\t * RULE-INTEGRITY-001: Compute SHA-256 hash for a validated session.\n24\t * Data is concatenated in deterministic order, separated by '|'.\n25\t */\n26\texport function computeSessionHash(input: HashInput): string {\n27\t  const parts: string[] = [\n28\t    input.sessionId,\n29\t    input.userId,\n30\t    input.ouvertureAt,\n31\t    input.validationAt,\n32\t  ];\n33\t\n34\t  // Movements sorted by createdAt then id\n35\t  const sortedMovements = [...input.mouvements].sort((a, b) =>\n36\t    a.createdAt === b.createdAt ? a.id.localeCompare(b.id) : a.createdAt.localeCompare(b.createdAt),\n37\t  );\n38\t  for (const m of sortedMovements) {\n39\t    parts.push(`${m.id}:${m.type}:${m.montant}:${m.mode}:${m.createdAt}`);\n40\t  }\n41\t\n42\t  // Cashier declarations sorted by mode\n43\t  const cashierModes = Object.keys(input.declarationsCaissier).sort();\n44\t  for (const mode of cashierModes) {\n45\t    parts.push(`C:${mode}:${input.declarationsCaissier[mode]}`);\n46\t  }\n47\t\n48\t  // Validator declarations sorted by mode (empty if force-close)\n49\t  if (input.declarationsValideur) {\n50\t    const valideurModes = Object.keys(input.declarationsValideur).sort();\n51\t    for (const mode of valideurModes) {\n52\t      parts.push(`V:${mode}:${input.declarationsValideur[mode]}`);\n53\t    }\n54\t  }\n55\t\n56\t  // Discrepancies sorted by mode\n57\t  const ecartModes = Object.keys(input.ecarts).sort();\n58\t  for (const mode of ecartModes) {\n59\t    parts.push(`E:${mode}:${input.ecarts[mode]}`);\n60\t  }\n61\t\n62\t  // Previous session hash (empty string if first session)\n63\t  parts.push(input.hashPrecedent);\n64\t\n65\t  const data = parts.join(\"|\");\n66\t  return createHash(\"sha256\").update(data, \"utf8\").digest(\"hex\");\n67\t}\n68\t\n69\t/**\n70\t * Build hash input from a session and its movements, then compute the hash.\n71\t */\n72\texport async function computeHashForSession(\n73\t  sessionId: string,\n74\t  validationAt: Date,\n75\t): Promise<string> {\n76\t  const session = await prisma.comptoirSession.findUniqueOrThrow({\n77\t    where: { id: sessionId },\n78\t    select: {\n79\t      id: true,\n80\t      userId: true,\n81\t      ouvertureAt: true,\n82\t      declarationsCaissier: true,\n83\t      declarationsValideur: true,\n84\t      ecartsParMode: true,\n85\t    },\n86\t  });\n87\t\n88\t  const mouvements = await prisma.mouvementCaisse.findMany({\n89\t    where: { sessionId },\n90\t    orderBy: { createdAt: \"asc\" },\n91\t    select: { id: true, type: true, montant: true, mode: true, createdAt: true },\n92\t  });\n93\t\n94\t  // Find previous session's hash for chaining\n95\t  const previousSession = await prisma.comptoirSession.findFirst({\n96\t    where: {\n97\t      id: { not: sessionId },\n98\t      statut: { in: [\"VALIDEE\", \"FORCEE\", \"CORRIGEE\", \"FERMEE\"] },\n99\t      ouvertureAt: { lt: session.ouvertureAt },\n100\t    },\n101\t    orderBy: { ouvertureAt: \"desc\" },\n102\t    select: { hashIntegrite: true },\n103\t  });\n104\t\n105\t  const ecarts: Record<string, number> = {};\n106\t  const ecartsParMode = session.ecartsParMode as Record<string, { ecart: number }> | null;\n107\t  if (ecartsParMode) {\n108\t    for (const [mode, data] of Object.entries(ecartsParMode)) {\n109\t      ecarts[mode] = data.ecart;\n110\t    }\n111\t  }\n112\t\n113\t  return computeSessionHash({\n114\t    sessionId: session.id,\n115\t    userId: session.userId,\n116\t    ouvertureAt: session.ouvertureAt.toISOString(),\n117\t    validationAt: validationAt.toISOString(),\n118\t    mouvements: mouvements.map((m) => ({\n119\t      id: m.id,\n120\t      type: m.type,\n121\t      montant: String(m.montant),\n122\t      mode: m.mode,\n123\t      createdAt: m.createdAt.toISOString(),\n124\t    })),\n125\t    declarationsCaissier: (session.declarationsCaissier as Record<string, number>) ?? {},\n126\t    declarationsValideur: (session.declarationsValideur as Record<string, number>) ?? null,\n127\t    ecarts,\n128\t    hashPrecedent: previousSession?.hashIntegrite ?? \"\",\n129\t  });\n130\t}\n131\t\n132\t/**\n133\t * RULE-INTEGRITY-002: Verify integrity of a validated session.\n134\t * Recalculates the hash and compares with the stored one.\n135\t */\n136\texport async function verifySessionIntegrity(\n137\t  sessionId: string,\n138\t): Promise<{ valid: boolean; storedHash: string | null; computedHash: string }> {\n139\t  const session = await prisma.comptoirSession.findUniqueOrThrow({\n140\t    where: { id: sessionId },\n141\t    select: { hashIntegrite: true, fermetureAt: true },\n142\t  });\n143\t\n144\t  const computedHash = await computeHashForSession(\n145\t    sessionId,\n146\t    session.fermetureAt ?? new Date(),\n147\t  );\n148\t\n149\t  return {\n150\t    valid: session.hashIntegrite === computedHash,\n151\t    storedHash: session.hashIntegrite,\n152\t    computedHash,\n153\t  };\n154\t}\n155\t"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"73f540de-7b22-439e-8b3c-794b568d7ca7","timestamp":"2026-06-26T04:46:09.750Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/lib/services/integrity.ts","content":"import { createHash } from \"crypto\";\nimport { prisma } from \"@/lib/db\";\n\ninterface HashInput {\n  sessionId: string;\n  userId: string;\n  ouvertureAt: string; // ISO 8601\n  validationAt: string; // ISO 8601\n  mouvements: Array<{\n    id: string;\n    type: string;\n    montant: string;\n    mode: string;\n    createdAt: string;\n  }>;\n  declarationsCaissier: Record<string, number>;\n  declarationsValideur: Record<string, number> | null;\n  ecarts: Record<string, number>;\n  hashPrecedent: string;\n}\n\n/**\n * RULE-INTEGRITY-001: Compute SHA-256 hash for a validated session.\n * Data is concatenated in deterministic order, separated by '|'.\n */\nexport function computeSessionHash(input: HashInput): string {\n  const parts: string[] = [\n    input.sessionId,\n    input.userId,\n    input.ouvertureAt,\n    input.validationAt,\n  ];\n\n  // Movements sorted by createdAt then id\n  const sortedMovements = [...input.mouvements].sort((a, b) =>\n    a.createdAt === b.createdAt ? a.id.localeCompare(b.id) : a.createdAt.localeCompare(b.createdAt),\n  );\n  for (const m of sortedMovements) {\n    parts.push(`${m.id}:${m.type}:${m.montant}:${m.mode}:${m.createdAt}`);\n  }\n\n  // Cashier declarations sorted by mode\n  const cashierModes = Object.keys(input.declarationsCaissier).sort();\n  for (const mode of cashierModes) {\n    parts.push(`C:${mode}:${input.declarationsCaissier[mode]}`);\n  }\n\n  // Validator declarations sorted by mode (empty if force-close)\n  if (input.declarationsValideur) {\n    const valideurModes = Object.keys(input.declarationsValideur).sort();\n    for (const mode of valideurModes) {\n      parts.push(`V:${mode}:${input.declarationsValideur[mode]}`);\n    }\n  }\n\n  // Discrepancies sorted by mode\n  const ecartModes = Object.keys(input.ecarts).sort();\n  for (const mode of ecartModes) {\n    parts.push(`E:${mode}:${input.ecarts[mode]}`);\n  }\n\n  // Previous session hash (empty string if first session)\n  parts.push(input.hashPrecedent);\n\n  const data = parts.join(\"|\");\n  return createHash(\"sha256\").update(data, \"utf8\").digest(\"hex\");\n}\n\n/**\n * Build hash input from a session and its movements, then compute the hash.\n */\nexport async function computeHashForSession(\n  sessionId: string,\n  validationAt: Date,\n): Promise<string> {\n  const session = await prisma.comptoirSession.findUniqueOrThrow({\n    where: { id: sessionId },\n    select: {\n      id: true,\n      userId: true,\n      ouvertureAt: true,\n      declarationsCaissier: true,\n      declarationsValideur: true,\n      ecartsParMode: true,\n    },\n  });\n\n  const mouvements = await prisma.mouvementCaisse.findMany({\n    where: { sessionId },\n    orderBy: { createdAt: \"asc\" },\n    select: { id: true, type: true, montant: true, mode: true, createdAt: true },\n  });\n\n  // Find previous session's hash for chaining\n  const previousSession = await prisma.comptoirSession.findFirst({\n    where: {\n      id: { not: sessionId },\n      statut: { in: [\"VALIDEE\", \"FORCEE\", \"CORRIGEE\", \"FERMEE\"] },\n      ouvertureAt: { lt: session.ouvertureAt },\n    },\n    orderBy: { ouvertureAt: \"desc\" },\n    select: { hashIntegrite: true },\n  });\n\n  const ecarts: Record<string, number> = {};\n  const ecartsParMode = session.ecartsParMode as Record<string, { ecart: number }> | null;\n  if (ecartsParMode) {\n    for (const [mode, data] of Object.entries(ecartsParMode)) {\n      ecarts[mode] = data.ecart;\n    }\n  }\n\n  return computeSessionHash({\n    sessionId: session.id,\n    userId: session.userId,\n    ouvertureAt: session.ouvertureAt.toISOString(),\n    validationAt: validationAt.toISOString(),\n    mouvements: mouvements.map((m) => ({\n      id: m.id,\n      type: m.type,\n      montant: String(m.montant),\n      mode: m.mode,\n      createdAt: m.createdAt.toISOString(),\n    })),\n    declarationsCaissier: (session.declarationsCaissier as Record<string, number>) ?? {},\n    declarationsValideur: (session.declarationsValideur as Record<string, number>) ?? null,\n    ecarts,\n    hashPrecedent: previousSession?.hashIntegrite ?? \"\",\n  });\n}\n\n/**\n * RULE-INTEGRITY-002: Verify integrity of a validated session.\n * Recalculates the hash and compares with the stored one.\n */\nexport async function verifySessionIntegrity(\n  sessionId: string,\n): Promise<{ valid: boolean; storedHash: string | null; computedHash: string }> {\n  const session = await prisma.comptoirSession.findUniqueOrThrow({\n    where: { id: sessionId },\n    select: { hashIntegrite: true, fermetureAt: true },\n  });\n\n  const computedHash = await computeHashForSession(\n    sessionId,\n    session.fermetureAt ?? new Date(),\n  );\n\n  return {\n    valid: session.hashIntegrite === computedHash,\n    storedHash: session.hashIntegrite,\n    computedHash,\n  };\n}\n","numLines":155,"startLine":1,"totalLines":155}}}
