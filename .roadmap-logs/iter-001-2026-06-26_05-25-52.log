sed.data.declarations as Record<string, number>;\n75\t    const declarationsCaissier = (session.declarationsCaissier as Record<string, number>) ?? {};\n76\t\n77\t    // Lot A (RULE-SOLDE-001/003) : même base théorique que `closure` (solde de session)\n78\t    const soldesParMode = await computeSoldeSession(id);\n79\t\n80\t    // Run reconciliation\n81\t    const reconcResult = await reconcile(\n82\t      soldesParMode,\n83\t      declarationsCaissier,\n84\t      declarationsValideur,\n85\t      session.tentativesRecomptage,\n86\t    );\n87\t\n88\t    await logActivity({\n89\t      action: ACTIONS.BLIND_VALIDATION_SUBMITTED,\n90\t      actorId: result.user.id,"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"4b1e7f35-4edb-4dd8-becf-067b5f194ff8","timestamp":"2026-06-26T04:54:50.915Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/app/api/comptoir/sessions/[id]/validate/route.ts","content":" */\nexport async function POST(\n  req: Request,\n  { params }: { params: Promise<{ id: string }> },\n) {\n  const result = await requireAuth();\n  if (!result.authenticated) return result.response;\n\n  if (!hasPermission(result.user.role, \"comptoir:valider_session\")) {\n    return Response.json(\n      { error: \"Seul un MANAGER ou ADMIN peut valider une session\" },\n      { status: 403 },\n    );\n  }\n\n  const { id } = await params;\n\n  try {\n    const session = await prisma.comptoirSession.findUnique({\n      where: { id },\n      select: {\n        id: true,\n        statut: true,\n        userId: true,\n        declarationsCaissier: true,\n        tentativesRecomptage: true,\n        caisseId: true,\n      },\n    });\n\n    if (!session) {\n      return Response.json({ error: \"Session introuvable\" }, { status: 404 });\n    }\n\n    if (session.statut !== \"EN_ATTENTE_VALIDATION\") {\n      return Response.json(\n        { error: \"La session n'est pas en attente de validation\" },\n        { status: 422 },\n      );\n    }\n\n    // RULE-AUTH-003: validator must be different from session owner\n    if (session.userId === result.user.id) {\n      return Response.json(\n        { error: \"Un caissier ne peut pas valider sa propre session\" },\n        { status: 403 },\n      );\n    }\n\n    const body = await req.json();\n    const parsed = validationAveugSchema.safeParse(body);\n    if (!parsed.success) {\n      return Response.json(\n        { error: \"Données invalides\", details: parsed.error.flatten() },\n        { status: 400 },\n      );\n    }\n\n    const declarationsValideur = parsed.data.declarations as Record<string, number>;\n    const declarationsCaissier = (session.declarationsCaissier as Record<string, number>) ?? {};\n\n    // Lot A (RULE-SOLDE-001/003) : même base théorique que `closure` (solde de session)\n    const soldesParMode = await computeSoldeSession(id);\n\n    // Run reconciliation\n    const reconcResult = await reconcile(\n      soldesParMode,\n      declarationsCaissier,\n      declarationsValideur,\n      session.tentativesRecomptage,\n    );\n\n    await logActivity({\n      action: ACTIONS.BLIND_VALIDATION_SUBMITTED,\n      actorId: result.user.id,","numLines":75,"startLine":16,"totalLines":267}}}
