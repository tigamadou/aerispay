{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0176wKbRZYXq3qZJLtsyV1xz","type":"tool_result","content":"The file /Users/amadou/Devs/projects/aerispay/web/app/prisma/schema.prisma has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"2ab6ed00-3af9-48b6-9604-41d20e1d79e6","timestamp":"2026-06-26T04:32:47.519Z","tool_use_result":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/prisma/schema.prisma","oldString":"  valideurId String?\n  valideur   User?   @relation(\"SessionValideur\", fields: [valideurId], references: [id])\n\n  ventes           Vente[]","newString":"  valideurId String?\n  valideur   User?   @relation(\"SessionValideur\", fields: [valideurId], references: [id])\n  caisseId   String\n  caisse     Caisse  @relation(fields: [caisseId], references: [id])\n\n  ventes           Vente[]","originalFile":"// Aligné sur ARCHITECTURE_MVP.md — champs en français\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider          = \"mysql\"\n  url               = env(\"DATABASE_URL\")\n  // `prisma migrate dev` : utilisateur avec droit CREATE DATABASE (souvent `root` en local).\n  // L’utilisateur app (`aerispay`) n’a en général pas ce droit → P3014 sans shadow.\n  shadowDatabaseUrl = env(\"SHADOW_DATABASE_URL\")\n}\n\n// ─── UTILISATEURS & AUTH ────────────────────────────\n\nmodel User {\n  id         String   @id @default(cuid())\n  nom        String\n  email      String   @unique\n  motDePasse String\n  role       Role     @default(CAISSIER)\n  actif      Boolean  @default(true)\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n\n  sessions               ComptoirSession[]\n  sessionsValidees       ComptoirSession[] @relation(\"SessionValideur\")\n  ventes                 Vente[]\n  mouvementsCaisseAuteur MouvementCaisse[] @relation(\"MouvementCaisseAuteur\")\n  activityLogs           ActivityLog[]\n\n  @@map(\"users\")\n}\n\nenum Role {\n  ADMIN\n  MANAGER\n  CAISSIER\n}\n\n// ─── MODULE STOCK ───────────────────────────────────\n\nmodel Categorie {\n  id          String   @id @default(cuid())\n  nom         String\n  description String?\n  couleur     String?\n  createdAt   DateTime @default(now())\n\n  produits Produit[]\n\n  @@map(\"categories\")\n}\n\nmodel Produit {\n  id           String   @id @default(cuid())\n  reference    String   @unique\n  codeBarres   String?  @unique\n  nom          String\n  description  String?\n  image        String?\n  prixAchat    Decimal  @db.Decimal(10, 2)\n  prixVente    Decimal  @db.Decimal(10, 2)\n  // M2 — Modèle de TAXE GLOBALE : la TVA de vente est calculée à partir de la config\n  // `Taxe` (active) appliquée à la base, et stockée dans `Vente.tva` / `Vente.taxesDetail`.\n  // Ce champ `Produit.tva` est un attribut CATALOGUE (informatif), PAS utilisé pour le\n  // calcul de la taxe de vente. La taxation par-ligne/multi-taux n'est pas implémentée.\n  tva          Decimal  @default(0) @db.Decimal(5, 2)\n  unite        String   @default(\"unité\")\n  stockActuel  Int      @default(0)\n  stockMinimum Int      @default(5)\n  stockMaximum Int?\n  actif        Boolean  @default(true)\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n\n  categorieId String\n  categorie   Categorie        @relation(fields: [categorieId], references: [id])\n  mouvements  MouvementStock[]\n  lignesVente LigneVente[]\n\n  @@map(\"produits\")\n}\n\nmodel MouvementStock {\n  id            String        @id @default(cuid())\n  type          TypeMouvement\n  quantite      Int\n  quantiteAvant Int\n  quantiteApres Int\n  motif         String?\n  reference     String?\n  createdAt     DateTime      @default(now())\n\n  produitId String\n  produit   Produit @relation(fields: [produitId], references: [id])\n  venteId   String?\n  vente     Vente?  @relation(fields: [venteId], references: [id])\n\n  @@map(\"mouvements_stock\")\n}\n\nenum TypeMouvement {\n  ENTREE\n  SORTIE\n  AJUSTEMENT\n  RETOUR\n  PERTE\n}\n\n// ─── MODULE CAISSE ────────────────────────────────────\n\nmodel Caisse {\n  id        String   @id @default(cuid())\n  nom       String\n  active    Boolean  @default(true)\n  createdAt DateTime @default(now())\n\n  mouvements MouvementCaisse[]\n  sessions   ComptoirSession[]\n\n  @@map(\"caisses\")\n}\n\n// ─── MODULE COMPTOIR / SESSIONS ──────────────────────\n\nmodel ComptoirSession {\n  id          String    @id @default(cuid())\n  ouvertureAt DateTime  @default(now())\n  fermetureAt DateTime?\n\n  // Montants declares a l'ouverture (snapshot de ce que le caissier compte)\n  montantOuvertureCash        Decimal @db.Decimal(10, 2)\n  montantOuvertureMobileMoney Decimal @default(0) @db.Decimal(10, 2)\n\n  // Déclarations caissier (étape 1 de clôture) — JSON { mode: montant }\n  declarationsCaissier Json?\n  demandeCloturAt      DateTime?\n\n  // Déclarations ouverture par mode — JSON { mode: montant }\n  declarationsOuverture Json?\n  // Écarts ouverture par mode — JSON [{ mode, theorique, declare, ecart, categorie }]\n  ecartsOuverture       Json?\n\n  // Déclarations valideur (étape 3 — validation à l'aveugle) — JSON { mode: montant }\n  declarationsValideur Json?\n\n  // Résultats fermeture (conservés pour rétrocompatibilité MVP)\n  montantFermetureCash        Decimal? @db.Decimal(10, 2)\n  montantFermetureMobileMoney Decimal? @db.Decimal(10, 2)\n  soldeTheoriqueCash          Decimal? @db.Decimal(10, 2)\n  soldeTheoriqueMobileMoney   Decimal? @db.Decimal(10, 2)\n  ecartCash                   Decimal? @db.Decimal(10, 2)\n  ecartMobileMoney            Decimal? @db.Decimal(10, 2)\n\n  // Écarts finaux par mode — JSON { mode: { theorique, declare, ecart, categorie } }\n  ecartsParMode Json?\n\n  // Intégrité\n  hashIntegrite         String? @db.VarChar(64)\n  hashSessionPrecedente String? @db.VarChar(64)\n\n  // Recomptage / contestation\n  tentativesRecomptage Int @default(0)\n\n  // Force-close\n  motifForceClose String? @db.Text\n\n  // Lot G — RULE-FOND-004 : imputation d'un écart d'ouverture à la session précédente\n  ecartOuvertureImputeSessionId String?\n\n  statut StatutSession @default(OUVERTE)\n  notes  String?\n\n  // Relations\n  userId     String\n  user       User    @relation(fields: [userId], references: [id])\n  valideurId String?\n  valideur   User?   @relation(\"SessionValideur\", fields: [valideurId], references: [id])\n\n  ventes           Vente[]\n  mouvementsCaisse MouvementCaisse[]\n\n  // Session corrective : cette session corrige une session originale\n  sessionCorrigeeId String?          @unique\n  sessionCorrigee   ComptoirSession? @relation(\"SessionCorrective\", fields: [sessionCorrigeeId], references: [id])\n  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n\n  @@map(\"comptoir_sessions\")\n}\n\nenum StatutSession {\n  OUVERTE\n  FERMEE // conservé pour rétrocompatibilité données existantes\n  EN_ATTENTE_CLOTURE\n  EN_ATTENTE_VALIDATION\n  VALIDEE\n  CONTESTEE\n  FORCEE\n  CORRIGEE\n}\n\n// ─── MODULE CAISSE — MOUVEMENTS ─────────────────────\n\nmodel MouvementCaisse {\n  id           String              @id @default(cuid())\n  type         TypeMouvementCaisse\n  mode         String\n  montant      Decimal             @db.Decimal(10, 2)\n  motif        String?\n  reference    String?\n  justificatif String?             @db.Text\n  offline      Boolean             @default(false)\n  createdAt    DateTime            @default(now())\n\n  caisseId  String\n  caisse    Caisse          @relation(fields: [caisseId], references: [id])\n  sessionId String?\n  session   ComptoirSession? @relation(fields: [sessionId], references: [id])\n  venteId   String?\n  vente     Vente?           @relation(fields: [venteId], references: [id])\n  auteurId  String\n  auteur    User             @relation(\"MouvementCaisseAuteur\", fields: [auteurId], references: [id])\n\n  @@index([caisseId])\n  @@index([sessionId])\n  @@index([venteId])\n  @@index([auteurId])\n  @@index([createdAt])\n  @@map(\"mouvements_caisse\")\n}\n\nenum TypeMouvementCaisse {\n  FOND_INITIAL\n  FOND_OUVERTURE // Lot G : fond/float rattaché à une session, créé à l'ouverture\n  LEVEE          // Lot G (Modèle 2) : levée des recettes vers le coffre à la clôture\n  VENTE\n  REMBOURSEMENT\n  APPORT\n  RETRAIT\n  DEPENSE\n  CORRECTION\n}\n\n// ─── MODULE CAISSE — SEUILS PARAMÉTRABLES ───────────\n\nmodel SeuilCaisse {\n  id          String   @id\n  valeur      Int\n  description String?\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  @@map(\"seuils_caisse\")\n}\n\n// ─── MODULE CAISSE — ÉVÉNEMENTS MÉTIER ──────────────\n\nmodel EventCaisse {\n  id          String   @id @default(cuid())\n  type        String   // EVT-SESSION-OPENED, EVT-CASH-MOVEMENT-CREATED, etc.\n  sessionId   String?\n  payload     Json\n  consumed    Boolean  @default(false)\n  createdAt   DateTime @default(now())\n\n  @@index([type])\n  @@index([sessionId])\n  @@index([consumed, createdAt])\n  @@map(\"events_caisse\")\n}\n\nmodel Vente {\n  id            String      @id @default(cuid())\n  numero        String      @unique\n  dateVente     DateTime    @default(now())\n  sousTotal     Decimal     @db.Decimal(10, 2)\n  remise        Decimal     @default(0) @db.Decimal(10, 2)\n  tva           Decimal     @default(0) @db.Decimal(10, 2)\n  taxesDetail   Json?\n  total         Decimal     @db.Decimal(10, 2)\n  statut        StatutVente @default(VALIDEE)\n  nomClient     String?\n  notesCaissier String?\n  createdAt     DateTime    @default(now())\n\n  sessionId        String\n  session          ComptoirSession   @relation(fields: [sessionId], references: [id])\n  userId           String\n  caissier         User              @relation(fields: [userId], references: [id])\n  lignes           LigneVente[]\n  paiements        Paiement[]\n  mouvementsStock  MouvementStock[]\n  mouvementsCaisse MouvementCaisse[]\n\n  @@map(\"ventes\")\n}\n\nenum StatutVente {\n  VALIDEE\n  ANNULEE\n  REMBOURSEE\n}\n\nmodel LigneVente {\n  id           String  @id @default(cuid())\n  quantite     Int\n  prixUnitaire Decimal @db.Decimal(10, 2)\n  remise       Decimal @default(0) @db.Decimal(10, 2)\n  // M2 — Taxe GLOBALE : pas de taxation par-ligne. Ce champ reste à 0 (conservé pour\n  // rétrocompat d'affichage). La TVA de la vente est portée par `Vente.tva` / `Vente.taxesDetail`.\n  tva          Decimal @default(0) @db.Decimal(10, 2)\n  sousTotal    Decimal @db.Decimal(10, 2)\n\n  venteId   String\n  vente     Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)\n  produitId String\n  produit   Produit @relation(fields: [produitId], references: [id])\n\n  @@map(\"lignes_vente\")\n}\n\n// M3 — Compteur de séquences transactionnel (numérotation des ventes, etc.).\n// Incrémenté atomiquement (UPDATE ... valeur = valeur + 1) → numéros uniques et\n// monotones sous concurrence, sans plafond annuel. Clé ex. \"VTE-2026\".\nmodel Sequence {\n  id        String   @id\n  valeur    Int      @default(0)\n  updatedAt DateTime @updatedAt\n\n  @@map(\"sequences\")\n}\n\nmodel Paiement {\n  id        String  @id @default(cuid())\n  mode      String\n  montant   Decimal @db.Decimal(10, 2)\n  reference String?\n  createdAt DateTime     @default(now())\n\n  venteId String\n  vente   Vente  @relation(fields: [venteId], references: [id], onDelete: Cascade)\n\n  @@map(\"paiements\")\n}\n\n// ─── PARAMÈTRES STRUCTURE ────────────────────────────\n\nmodel Parametres {\n  id          String   @id @default(\"default\")\n  nomCommerce String   @default(\"\")\n  adresse     String   @default(\"\")\n  telephone   String   @default(\"\")\n  email       String   @default(\"\")\n  rccm        String   @default(\"\")\n  nif         String   @default(\"\")\n  logo        String?  @db.MediumText\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  taxes          Taxe[]\n  modesPaiement  ModePaiementConfig[]\n\n  @@map(\"parametres\")\n}\n\nmodel ModePaiementConfig {\n  id     String  @id @default(cuid())\n  code   String  @unique\n  label  String\n  active Boolean @default(true)\n  ordre  Int     @default(0)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  parametresId String     @default(\"default\")\n  parametres   Parametres @relation(fields: [parametresId], references: [id])\n\n  @@map(\"modes_paiement\")\n}\n\nmodel Taxe {\n  id        String   @id @default(cuid())\n  nom       String\n  taux      Decimal  @db.Decimal(5, 2)\n  active    Boolean  @default(true)\n  ordre     Int      @default(0)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  parametresId String     @default(\"default\")\n  parametres   Parametres @relation(fields: [parametresId], references: [id])\n\n  @@map(\"taxes\")\n}\n\n// ─── JOURNAL D'ACTIVITÉ ─────────────────────────────\n\nmodel ActivityLog {\n  id         String   @id @default(cuid())\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ipAddress  String?  @db.VarChar(45)\n  userAgent  String?  @db.Text\n  createdAt  DateTime @default(now())\n\n  actorId String?\n  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)\n\n  @@index([createdAt])\n  @@index([actorId])\n  @@index([action])\n  @@index([entityType, entityId])\n  @@map(\"activity_logs\")\n}\n","structuredPatch":[{"oldStart":177,"oldLines":6,"newStart":177,"newLines":8,"lines":["   user       User    @relation(fields: [userId], references: [id])","   valideurId String?","   valideur   User?   @relation(\"SessionValideur\", fields: [valideurId], references: [id])","+  caisseId   String","+  caisse     Caisse  @relation(fields: [caisseId], references: [id])"," ","   ventes           Vente[]","   mouvementsCaisse MouvementCaisse[]"]}],"userModified":false,"replaceAll":false}}
{"type":"assistant","message":{"model":"claude-opus-4-8","id":"msg_015ZtTuEGSjfqEZ2GytWZ8Nt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NednUbDxsJkpwiEZr4GGZG","name":"Edit","input":{"replace_all":false,"file_path":"/Users/amadou/Devs/projects/aerispay/web/app/prisma/schema.prisma","old_string":"  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n\n  @@map(\"comptoir_sessions\")\n}","new_string":"  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n\n  @@index([caisseId, statut])\n  @@map(\"comptoir_sessions\")\n}"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":357,"cache_read_input_tokens":233341,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":357},"output_tokens":55,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"211d5972-e4bc-428f-a20d-ad2befaf9293","request_id":"req_011CcRFDrd1dryRszz3N79kT"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NednUbDxsJkpwiEZr4GGZG","type":"tool_result","content":"The file /Users/amadou/Devs/projects/aerispay/web/app/prisma/schema.prisma has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"1e42acb7-3625-4d05-8912-27f875f450f7","timestamp":"2026-06-26T04:32:51.604Z","tool_use_result":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/prisma/schema.prisma","oldString":"  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n\n  @@map(\"comptoir_sessions\")\n}","newString":"  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n\n  @@index([caisseId, statut])\n  @@map(\"comptoir_sessions\")\n}","originalFile":"// Aligné sur ARCHITECTURE_MVP.md — champs en français\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\ndatasource db {\n  provider          = \"mysql\"\n  url               = env(\"DATABASE_URL\")\n  // `prisma migrate dev` : utilisateur avec droit CREATE DATABASE (souvent `root` en local).\n  // L’utilisateur app (`aerispay`) n’a en général pas ce droit → P3014 sans shadow.\n  shadowDatabaseUrl = env(\"SHADOW_DATABASE_URL\")\n}\n\n// ─── UTILISATEURS & AUTH ────────────────────────────\n\nmodel User {\n  id         String   @id @default(cuid())\n  nom        String\n  email      String   @unique\n  motDePasse String\n  role       Role     @default(CAISSIER)\n  actif      Boolean  @default(true)\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n\n  sessions               ComptoirSession[]\n  sessionsValidees       ComptoirSession[] @relation(\"SessionValideur\")\n  ventes                 Vente[]\n  mouvementsCaisseAuteur MouvementCaisse[] @relation(\"MouvementCaisseAuteur\")\n  activityLogs           ActivityLog[]\n\n  @@map(\"users\")\n}\n\nenum Role {\n  ADMIN\n  MANAGER\n  CAISSIER\n}\n\n// ─── MODULE STOCK ───────────────────────────────────\n\nmodel Categorie {\n  id          String   @id @default(cuid())\n  nom         String\n  description String?\n  couleur     String?\n  createdAt   DateTime @default(now())\n\n  produits Produit[]\n\n  @@map(\"categories\")\n}\n\nmodel Produit {\n  id           String   @id @default(cuid())\n  reference    String   @unique\n  codeBarres   String?  @unique\n  nom          String\n  description  String?\n  image        String?\n  prixAchat    Decimal  @db.Decimal(10, 2)\n  prixVente    Decimal  @db.Decimal(10, 2)\n  // M2 — Modèle de TAXE GLOBALE : la TVA de vente est calculée à partir de la config\n  // `Taxe` (active) appliquée à la base, et stockée dans `Vente.tva` / `Vente.taxesDetail`.\n  // Ce champ `Produit.tva` est un attribut CATALOGUE (informatif), PAS utilisé pour le\n  // calcul de la taxe de vente. La taxation par-ligne/multi-taux n'est pas implémentée.\n  tva          Decimal  @default(0) @db.Decimal(5, 2)\n  unite        String   @default(\"unité\")\n  stockActuel  Int      @default(0)\n  stockMinimum Int      @default(5)\n  stockMaximum Int?\n  actif        Boolean  @default(true)\n  createdAt    DateTime @default(now())\n  updatedAt    DateTime @updatedAt\n\n  categorieId String\n  categorie   Categorie        @relation(fields: [categorieId], references: [id])\n  mouvements  MouvementStock[]\n  lignesVente LigneVente[]\n\n  @@map(\"produits\")\n}\n\nmodel MouvementStock {\n  id            String        @id @default(cuid())\n  type          TypeMouvement\n  quantite      Int\n  quantiteAvant Int\n  quantiteApres Int\n  motif         String?\n  reference     String?\n  createdAt     DateTime      @default(now())\n\n  produitId String\n  produit   Produit @relation(fields: [produitId], references: [id])\n  venteId   String?\n  vente     Vente?  @relation(fields: [venteId], references: [id])\n\n  @@map(\"mouvements_stock\")\n}\n\nenum TypeMouvement {\n  ENTREE\n  SORTIE\n  AJUSTEMENT\n  RETOUR\n  PERTE\n}\n\n// ─── MODULE CAISSE ────────────────────────────────────\n\nmodel Caisse {\n  id        String   @id @default(cuid())\n  nom       String\n  active    Boolean  @default(true)\n  createdAt DateTime @default(now())\n\n  mouvements MouvementCaisse[]\n  sessions   ComptoirSession[]\n\n  @@map(\"caisses\")\n}\n\n// ─── MODULE COMPTOIR / SESSIONS ──────────────────────\n\nmodel ComptoirSession {\n  id          String    @id @default(cuid())\n  ouvertureAt DateTime  @default(now())\n  fermetureAt DateTime?\n\n  // Montants declares a l'ouverture (snapshot de ce que le caissier compte)\n  montantOuvertureCash        Decimal @db.Decimal(10, 2)\n  montantOuvertureMobileMoney Decimal @default(0) @db.Decimal(10, 2)\n\n  // Déclarations caissier (étape 1 de clôture) — JSON { mode: montant }\n  declarationsCaissier Json?\n  demandeCloturAt      DateTime?\n\n  // Déclarations ouverture par mode — JSON { mode: montant }\n  declarationsOuverture Json?\n  // Écarts ouverture par mode — JSON [{ mode, theorique, declare, ecart, categorie }]\n  ecartsOuverture       Json?\n\n  // Déclarations valideur (étape 3 — validation à l'aveugle) — JSON { mode: montant }\n  declarationsValideur Json?\n\n  // Résultats fermeture (conservés pour rétrocompatibilité MVP)\n  montantFermetureCash        Decimal? @db.Decimal(10, 2)\n  montantFermetureMobileMoney Decimal? @db.Decimal(10, 2)\n  soldeTheoriqueCash          Decimal? @db.Decimal(10, 2)\n  soldeTheoriqueMobileMoney   Decimal? @db.Decimal(10, 2)\n  ecartCash                   Decimal? @db.Decimal(10, 2)\n  ecartMobileMoney            Decimal? @db.Decimal(10, 2)\n\n  // Écarts finaux par mode — JSON { mode: { theorique, declare, ecart, categorie } }\n  ecartsParMode Json?\n\n  // Intégrité\n  hashIntegrite         String? @db.VarChar(64)\n  hashSessionPrecedente String? @db.VarChar(64)\n\n  // Recomptage / contestation\n  tentativesRecomptage Int @default(0)\n\n  // Force-close\n  motifForceClose String? @db.Text\n\n  // Lot G — RULE-FOND-004 : imputation d'un écart d'ouverture à la session précédente\n  ecartOuvertureImputeSessionId String?\n\n  statut StatutSession @default(OUVERTE)\n  notes  String?\n\n  // Relations\n  userId     String\n  user       User    @relation(fields: [userId], references: [id])\n  valideurId String?\n  valideur   User?   @relation(\"SessionValideur\", fields: [valideurId], references: [id])\n  caisseId   String\n  caisse     Caisse  @relation(fields: [caisseId], references: [id])\n\n  ventes           Vente[]\n  mouvementsCaisse MouvementCaisse[]\n\n  // Session corrective : cette session corrige une session originale\n  sessionCorrigeeId String?          @unique\n  sessionCorrigee   ComptoirSession? @relation(\"SessionCorrective\", fields: [sessionCorrigeeId], references: [id])\n  sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")\n\n  @@map(\"comptoir_sessions\")\n}\n\nenum StatutSession {\n  OUVERTE\n  FERMEE // conservé pour rétrocompatibilité données existantes\n  EN_ATTENTE_CLOTURE\n  EN_ATTENTE_VALIDATION\n  VALIDEE\n  CONTESTEE\n  FORCEE\n  CORRIGEE\n}\n\n// ─── MODULE CAISSE — MOUVEMENTS ─────────────────────\n\nmodel MouvementCaisse {\n  id           String              @id @default(cuid())\n  type         TypeMouvementCaisse\n  mode         String\n  montant      Decimal             @db.Decimal(10, 2)\n  motif        String?\n  reference    String?\n  justificatif String?             @db.Text\n  offline      Boolean             @default(false)\n  createdAt    DateTime            @default(now())\n\n  caisseId  String\n  caisse    Caisse          @relation(fields: [caisseId], references: [id])\n  sessionId String?\n  session   ComptoirSession? @relation(fields: [sessionId], references: [id])\n  venteId   String?\n  vente     Vente?           @relation(fields: [venteId], references: [id])\n  auteurId  String\n  auteur    User             @relation(\"MouvementCaisseAuteur\", fields: [auteurId], references: [id])\n\n  @@index([caisseId])\n  @@index([sessionId])\n  @@index([venteId])\n  @@index([auteurId])\n  @@index([createdAt])\n  @@map(\"mouvements_caisse\")\n}\n\nenum TypeMouvementCaisse {\n  FOND_INITIAL\n  FOND_OUVERTURE // Lot G : fond/float rattaché à une session, créé à l'ouverture\n  LEVEE          // Lot G (Modèle 2) : levée des recettes vers le coffre à la clôture\n  VENTE\n  REMBOURSEMENT\n  APPORT\n  RETRAIT\n  DEPENSE\n  CORRECTION\n}\n\n// ─── MODULE CAISSE — SEUILS PARAMÉTRABLES ───────────\n\nmodel SeuilCaisse {\n  id          String   @id\n  valeur      Int\n  description String?\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  @@map(\"seuils_caisse\")\n}\n\n// ─── MODULE CAISSE — ÉVÉNEMENTS MÉTIER ──────────────\n\nmodel EventCaisse {\n  id          String   @id @default(cuid())\n  type        String   // EVT-SESSION-OPENED, EVT-CASH-MOVEMENT-CREATED, etc.\n  sessionId   String?\n  payload     Json\n  consumed    Boolean  @default(false)\n  createdAt   DateTime @default(now())\n\n  @@index([type])\n  @@index([sessionId])\n  @@index([consumed, createdAt])\n  @@map(\"events_caisse\")\n}\n\nmodel Vente {\n  id            String      @id @default(cuid())\n  numero        String      @unique\n  dateVente     DateTime    @default(now())\n  sousTotal     Decimal     @db.Decimal(10, 2)\n  remise        Decimal     @default(0) @db.Decimal(10, 2)\n  tva           Decimal     @default(0) @db.Decimal(10, 2)\n  taxesDetail   Json?\n  total         Decimal     @db.Decimal(10, 2)\n  statut        StatutVente @default(VALIDEE)\n  nomClient     String?\n  notesCaissier String?\n  createdAt     DateTime    @default(now())\n\n  sessionId        String\n  session          ComptoirSession   @relation(fields: [sessionId], references: [id])\n  userId           String\n  caissier         User              @relation(fields: [userId], references: [id])\n  lignes           LigneVente[]\n  paiements        Paiement[]\n  mouvementsStock  MouvementStock[]\n  mouvementsCaisse MouvementCaisse[]\n\n  @@map(\"ventes\")\n}\n\nenum StatutVente {\n  VALIDEE\n  ANNULEE\n  REMBOURSEE\n}\n\nmodel LigneVente {\n  id           String  @id @default(cuid())\n  quantite     Int\n  prixUnitaire Decimal @db.Decimal(10, 2)\n  remise       Decimal @default(0) @db.Decimal(10, 2)\n  // M2 — Taxe GLOBALE : pas de taxation par-ligne. Ce champ reste à 0 (conservé pour\n  // rétrocompat d'affichage). La TVA de la vente est portée par `Vente.tva` / `Vente.taxesDetail`.\n  tva          Decimal @default(0) @db.Decimal(10, 2)\n  sousTotal    Decimal @db.Decimal(10, 2)\n\n  venteId   String\n  vente     Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)\n  produitId String\n  produit   Produit @relation(fields: [produitId], references: [id])\n\n  @@map(\"lignes_vente\")\n}\n\n// M3 — Compteur de séquences transactionnel (numérotation des ventes, etc.).\n// Incrémenté atomiquement (UPDATE ... valeur = valeur + 1) → numéros uniques et\n// monotones sous concurrence, sans plafond annuel. Clé ex. \"VTE-2026\".\nmodel Sequence {\n  id        String   @id\n  valeur    Int      @default(0)\n  updatedAt DateTime @updatedAt\n\n  @@map(\"sequences\")\n}\n\nmodel Paiement {\n  id        String  @id @default(cuid())\n  mode      String\n  montant   Decimal @db.Decimal(10, 2)\n  reference String?\n  createdAt DateTime     @default(now())\n\n  venteId String\n  vente   Vente  @relation(fields: [venteId], references: [id], onDelete: Cascade)\n\n  @@map(\"paiements\")\n}\n\n// ─── PARAMÈTRES STRUCTURE ────────────────────────────\n\nmodel Parametres {\n  id          String   @id @default(\"default\")\n  nomCommerce String   @default(\"\")\n  adresse     String   @default(\"\")\n  telephone   String   @default(\"\")\n  email       String   @default(\"\")\n  rccm        String   @default(\"\")\n  nif         String   @default(\"\")\n  logo        String?  @db.MediumText\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  taxes          Taxe[]\n  modesPaiement  ModePaiementConfig[]\n\n  @@map(\"parametres\")\n}\n\nmodel ModePaiementConfig {\n  id     String  @id @default(cuid())\n  code   String  @unique\n  label  String\n  active Boolean @default(true)\n  ordre  Int     @default(0)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  parametresId String     @default(\"default\")\n  parametres   Parametres @relation(fields: [parametresId], references: [id])\n\n  @@map(\"modes_paiement\")\n}\n\nmodel Taxe {\n  id        String   @id @default(cuid())\n  nom       String\n  taux      Decimal  @db.Decimal(5, 2)\n  active    Boolean  @default(true)\n  ordre     Int      @default(0)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  parametresId String     @default(\"default\")\n  parametres   Parametres @relation(fields: [parametresId], references: [id])\n\n  @@map(\"taxes\")\n}\n\n// ─── JOURNAL D'ACTIVITÉ ─────────────────────────────\n\nmodel ActivityLog {\n  id         String   @id @default(cuid())\n  action     String\n  entityType String?\n  entityId   String?\n  metadata   Json?\n  ipAddress  String?  @db.VarChar(45)\n  userAgent  String?  @db.Text\n  createdAt  DateTime @default(now())\n\n  actorId String?\n  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)\n\n  @@index([createdAt])\n  @@index([actorId])\n  @@index([action])\n  @@index([entityType, entityId])\n  @@map(\"activity_logs\")\n}\n","structuredPatch":[{"oldStart":188,"oldLines":6,"newStart":188,"newLines":7,"lines":["   sessionCorrigee   ComptoirSession? @relation(\"SessionCorrective\", fields: [sessionCorrigeeId], references: [id])","   sessionCorrective ComptoirSession? @relation(\"SessionCorrective\")"," ","+  @@index([caisseId, statut])","   @@map(\"comptoir_sessions\")"," }"," "]}],"userModified":false,"replaceAll":false}}
