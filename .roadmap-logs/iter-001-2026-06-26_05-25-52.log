{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nixo9w1H8gUSkfo7cpNxzT","type":"tool_result","content":"1\timport type { Prisma } from \"@prisma/client\";\n2\t\n3\timport { prisma } from \"@/lib/db\";\n4\t\n5\t// ─── Event type constants ───────────────────────────\n6\t\n7\texport const EVENTS = {\n8\t  SESSION_OPENED: \"EVT-SESSION-OPENED\",\n9\t  CASH_MOVEMENT_CREATED: \"EVT-CASH-MOVEMENT-CREATED\",\n10\t  SESSION_CLOSURE_REQUESTED: \"EVT-SESSION-CLOSURE-REQUESTED\",\n11\t  SESSION_VALIDATED: \"EVT-SESSION-VALIDATED\",\n12\t  DISCREPANCY_DETECTED: \"EVT-DISCREPANCY-DETECTED\",\n13\t  SESSION_DISPUTED: \"EVT-SESSION-DISPUTED\",\n14\t  SESSION_FORCE_CLOSED: \"EVT-SESSION-FORCE-CLOSED\",\n15\t  SESSION_CORRECTED: \"EVT-SESSION-CORRECTED\",\n16\t} as const;\n17\t\n18\texport type EventType = (typeof EVENTS)[keyof typeof EVENTS];\n19\t\n20\tinterface EmitParams {\n21\t  type: EventType;\n22\t  sessionId?: string;\n23\t  payload: Record<string, unknown>;\n24\t}\n25\t\n26\t/**\n27\t * Emit a business event for future consumption (e.g. by a comptabilité module).\n28\t * Events are persisted in the events_caisse table.\n29\t * This function never throws — event emission must not break the main operation.\n30\t */\n31\texport async function emitEvent(params: EmitParams): Promise<void> {\n32\t  try {\n33\t    await prisma.eventCaisse.create({\n34\t      data: {\n35\t        type: params.type,\n36\t        sessionId: params.sessionId ?? null,\n37\t        payload: params.payload as Prisma.InputJsonValue,\n38\t      },\n39\t    });\n40\t  } catch (error) {\n41\t    console.error(\"[emitEvent]\", error);\n42\t  }\n43\t}\n44\t\n45\t/**\n46\t * List unconsumed events, ordered by creation time.\n47\t * Used by future consumers (comptabilité module).\n48\t */\n49\texport async function listUnconsumedEvents(limit = 100) {\n50\t  return prisma.eventCaisse.findMany({\n51\t    where: { consumed: false },\n52\t    orderBy: { createdAt: \"asc\" },\n53\t    take: limit,\n54\t  });\n55\t}\n56\t\n57\t/**\n58\t * Mark events as consumed (after processing by a consumer).\n59\t */\n60\texport async function markEventsConsumed(ids: string[]): Promise<void> {\n61\t  await prisma.eventCaisse.updateMany({\n62\t    where: { id: { in: ids } },\n63\t    data: { consumed: true },\n64\t  });\n65\t}\n66\t"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"9591d560-e89c-444a-b227-b1f7da9bbce8","timestamp":"2026-06-26T04:49:19.682Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/lib/services/event-emitter.ts","content":"import type { Prisma } from \"@prisma/client\";\n\nimport { prisma } from \"@/lib/db\";\n\n// ─── Event type constants ───────────────────────────\n\nexport const EVENTS = {\n  SESSION_OPENED: \"EVT-SESSION-OPENED\",\n  CASH_MOVEMENT_CREATED: \"EVT-CASH-MOVEMENT-CREATED\",\n  SESSION_CLOSURE_REQUESTED: \"EVT-SESSION-CLOSURE-REQUESTED\",\n  SESSION_VALIDATED: \"EVT-SESSION-VALIDATED\",\n  DISCREPANCY_DETECTED: \"EVT-DISCREPANCY-DETECTED\",\n  SESSION_DISPUTED: \"EVT-SESSION-DISPUTED\",\n  SESSION_FORCE_CLOSED: \"EVT-SESSION-FORCE-CLOSED\",\n  SESSION_CORRECTED: \"EVT-SESSION-CORRECTED\",\n} as const;\n\nexport type EventType = (typeof EVENTS)[keyof typeof EVENTS];\n\ninterface EmitParams {\n  type: EventType;\n  sessionId?: string;\n  payload: Record<string, unknown>;\n}\n\n/**\n * Emit a business event for future consumption (e.g. by a comptabilité module).\n * Events are persisted in the events_caisse table.\n * This function never throws — event emission must not break the main operation.\n */\nexport async function emitEvent(params: EmitParams): Promise<void> {\n  try {\n    await prisma.eventCaisse.create({\n      data: {\n        type: params.type,\n        sessionId: params.sessionId ?? null,\n        payload: params.payload as Prisma.InputJsonValue,\n      },\n    });\n  } catch (error) {\n    console.error(\"[emitEvent]\", error);\n  }\n}\n\n/**\n * List unconsumed events, ordered by creation time.\n * Used by future consumers (comptabilité module).\n */\nexport async function listUnconsumedEvents(limit = 100) {\n  return prisma.eventCaisse.findMany({\n    where: { consumed: false },\n    orderBy: { createdAt: \"asc\" },\n    take: limit,\n  });\n}\n\n/**\n * Mark events as consumed (after processing by a consumer).\n */\nexport async function markEventsConsumed(ids: string[]): Promise<void> {\n  await prisma.eventCaisse.updateMany({\n    where: { id: { in: ids } },\n    data: { consumed: true },\n  });\n}\n","numLines":66,"startLine":1,"totalLines":66}}}
