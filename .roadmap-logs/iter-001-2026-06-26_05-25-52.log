s-1\", statut: \"VALIDEE\", userId: \"user-1\", sessionCorrective: null, caisseId: \"caisse-7\",\n    });\n\n    let createData: Record<string, unknown> | undefined;\n    (prisma.$transaction as ReturnType<typeof vi.fn>).mockImplementation(async (fn: Function) => {\n      const tx = {\n        comptoirSession: {\n          create: vi.fn().mockImplementation(async ({ data }: { data: Record<string, unknown> }) => {\n            createData = data;\n            return { id: \"s-corrective\", statut: \"VALIDEE\", ...data };\n          }),\n          update: vi.fn(),\n        },\n      };\n      return fn(tx);\n    });\n\n    const res = await POST(jsonReq(validBody), ctx);\n    expect(res.status).toBe(201);\n    expect(createData?.caisseId).toBe(\"caisse-7\");\n  });\n});"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1656,"cache_creation_input_tokens":646,"cache_read_input_tokens":187280,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":646},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"a7571e7a-c36b-4bc0-8fa7-e1ab32cc19e8","request_id":"req_011CcREiPEBcPonpSa3HxrLj"}
