{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018BZiFbviUegJUYEB2ZtBpH","type":"tool_result","content":"1\timport { describe, it, expect, vi, beforeEach } from \"vitest\";\n2\t\n3\tvi.mock(\"@/lib/db\", () => ({\n4\t  prisma: {\n5\t    eventCaisse: {\n6\t      create: vi.fn(),\n7\t      findMany: vi.fn(),\n8\t      updateMany: vi.fn(),\n9\t    },\n10\t  },\n11\t}));\n12\t\n13\timport { prisma } from \"@/lib/db\";\n14\timport { emitEvent, listUnconsumedEvents, markEventsConsumed, EVENTS } from \"@/lib/services/event-emitter\";\n15\t\n16\tdescribe(\"EventEmitterService\", () => {\n17\t  beforeEach(() => vi.clearAllMocks());\n18\t\n19\t  describe(\"EVENTS constants\", () => {\n20\t    it(\"defines all required event types\", () => {\n21\t      expect(EVENTS.SESSION_OPENED).toBe(\"EVT-SESSION-OPENED\");\n22\t      expect(EVENTS.CASH_MOVEMENT_CREATED).toBe(\"EVT-CASH-MOVEMENT-CREATED\");\n23\t      expect(EVENTS.SESSION_CLOSURE_REQUESTED).toBe(\"EVT-SESSION-CLOSURE-REQUESTED\");\n24\t      expect(EVENTS.SESSION_VALIDATED).toBe(\"EVT-SESSION-VALIDATED\");\n25\t      expect(EVENTS.DISCREPANCY_DETECTED).toBe(\"EVT-DISCREPANCY-DETECTED\");\n26\t      expect(EVENTS.SESSION_DISPUTED).toBe(\"EVT-SESSION-DISPUTED\");\n27\t      expect(EVENTS.SESSION_FORCE_CLOSED).toBe(\"EVT-SESSION-FORCE-CLOSED\");\n28\t      expect(EVENTS.SESSION_CORRECTED).toBe(\"EVT-SESSION-CORRECTED\");\n29\t    });\n30\t  });\n31\t\n32\t  describe(\"emitEvent\", () => {\n33\t    it(\"creates an event in the database\", async () => {\n34\t      await emitEvent({\n35\t        type: EVENTS.SESSION_OPENED,\n36\t        sessionId: \"s-1\",\n37\t        payload: { caissier: \"u-1\", fondCaisse: 50000 },\n38\t      });\n39\t\n40\t      expect(prisma.eventCaisse.create).toHaveBeenCalledWith({\n41\t        data: {\n42\t          type: \"EVT-SESSION-OPENED\",\n43\t          sessionId: \"s-1\",\n44\t          payload: { caissier: \"u-1\", fondCaisse: 50000 },\n45\t        },\n46\t      });\n47\t    });\n48\t\n49\t    it(\"does not throw on DB error\", async () => {\n50\t      (prisma.eventCaisse.create as ReturnType<typeof vi.fn>).mockRejectedValue(new Error(\"DB\"));\n51\t      // Should not throw\n52\t      await expect(emitEvent({\n53\t        type: EVENTS.SESSION_VALIDATED,\n54\t        payload: { test: true },\n55\t      })).resolves.toBeUndefined();\n56\t    });\n57\t\n58\t    it(\"passes null sessionId when not provided\", async () => {\n59\t      await emitEvent({\n60\t        type: EVENTS.DISCREPANCY_DETECTED,\n61\t        payload: { ecart: -2000 },\n62\t      });\n63\t\n64\t      expect(prisma.eventCaisse.create).toHaveBeenCalledWith({\n65\t        data: expect.objectContaining({ sessionId: null }),\n66\t      });\n67\t    });\n68\t  });\n69\t\n70\t  describe(\"listUnconsumedEvents\", () => {\n71\t    it(\"queries unconsumed events ordered by createdAt\", async () => {\n72\t      (prisma.eventCaisse.findMany as ReturnType<typeof vi.fn>).mockResolvedValue([]);\n73\t      const result = await listUnconsumedEvents(50);\n74\t      expect(prisma.eventCaisse.findMany).toHaveBeenCalledWith({\n75\t        where: { consumed: false },\n76\t        orderBy: { createdAt: \"asc\" },\n77\t        take: 50,\n78\t      });\n79\t      expect(result).toEqual([]);\n80\t    });\n81\t  });\n82\t\n83\t  describe(\"markEventsConsumed\", () => {\n84\t    it(\"updates events as consumed\", async () => {\n85\t      await markEventsConsumed([\"e-1\", \"e-2\"]);\n86\t      expect(prisma.eventCaisse.updateMany).toHaveBeenCalledWith({\n87\t        where: { id: { in: [\"e-1\", \"e-2\"] } },\n88\t        data: { consumed: true },\n89\t      });\n90\t    });\n91\t  });\n92\t});\n93\t"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"0542e2c3-9bf6-4216-8847-3c4531782286","timestamp":"2026-06-26T04:49:07.892Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/__tests__/caisse/event-emitter.test.ts","content":"import { describe, it, expect, vi, beforeEach } from \"vitest\";\n\nvi.mock(\"@/lib/db\", () => ({\n  prisma: {\n    eventCaisse: {\n      create: vi.fn(),\n      findMany: vi.fn(),\n      updateMany: vi.fn(),\n    },\n  },\n}));\n\nimport { prisma } from \"@/lib/db\";\nimport { emitEvent, listUnconsumedEvents, markEventsConsumed, EVENTS } from \"@/lib/services/event-emitter\";\n\ndescribe(\"EventEmitterService\", () => {\n  beforeEach(() => vi.clearAllMocks());\n\n  describe(\"EVENTS constants\", () => {\n    it(\"defines all required event types\", () => {\n      expect(EVENTS.SESSION_OPENED).toBe(\"EVT-SESSION-OPENED\");\n      expect(EVENTS.CASH_MOVEMENT_CREATED).toBe(\"EVT-CASH-MOVEMENT-CREATED\");\n      expect(EVENTS.SESSION_CLOSURE_REQUESTED).toBe(\"EVT-SESSION-CLOSURE-REQUESTED\");\n      expect(EVENTS.SESSION_VALIDATED).toBe(\"EVT-SESSION-VALIDATED\");\n      expect(EVENTS.DISCREPANCY_DETECTED).toBe(\"EVT-DISCREPANCY-DETECTED\");\n      expect(EVENTS.SESSION_DISPUTED).toBe(\"EVT-SESSION-DISPUTED\");\n      expect(EVENTS.SESSION_FORCE_CLOSED).toBe(\"EVT-SESSION-FORCE-CLOSED\");\n      expect(EVENTS.SESSION_CORRECTED).toBe(\"EVT-SESSION-CORRECTED\");\n    });\n  });\n\n  describe(\"emitEvent\", () => {\n    it(\"creates an event in the database\", async () => {\n      await emitEvent({\n        type: EVENTS.SESSION_OPENED,\n        sessionId: \"s-1\",\n        payload: { caissier: \"u-1\", fondCaisse: 50000 },\n      });\n\n      expect(prisma.eventCaisse.create).toHaveBeenCalledWith({\n        data: {\n          type: \"EVT-SESSION-OPENED\",\n          sessionId: \"s-1\",\n          payload: { caissier: \"u-1\", fondCaisse: 50000 },\n        },\n      });\n    });\n\n    it(\"does not throw on DB error\", async () => {\n      (prisma.eventCaisse.create as ReturnType<typeof vi.fn>).mockRejectedValue(new Error(\"DB\"));\n      // Should not throw\n      await expect(emitEvent({\n        type: EVENTS.SESSION_VALIDATED,\n        payload: { test: true },\n      })).resolves.toBeUndefined();\n    });\n\n    it(\"passes null sessionId when not provided\", async () => {\n      await emitEvent({\n        type: EVENTS.DISCREPANCY_DETECTED,\n        payload: { ecart: -2000 },\n      });\n\n      expect(prisma.eventCaisse.create).toHaveBeenCalledWith({\n        data: expect.objectContaining({ sessionId: null }),\n      });\n    });\n  });\n\n  describe(\"listUnconsumedEvents\", () => {\n    it(\"queries unconsumed events ordered by createdAt\", async () => {\n      (prisma.eventCaisse.findMany as ReturnType<typeof vi.fn>).mockResolvedValue([]);\n      const result = await listUnconsumedEvents(50);\n      expect(prisma.eventCaisse.findMany).toHaveBeenCalledWith({\n        where: { consumed: false },\n        orderBy: { createdAt: \"asc\" },\n        take: 50,\n      });\n      expect(result).toEqual([]);\n    });\n  });\n\n  describe(\"markEventsConsumed\", () => {\n    it(\"updates events as consumed\", async () => {\n      await markEventsConsumed([\"e-1\", \"e-2\"]);\n      expect(prisma.eventCaisse.updateMany).toHaveBeenCalledWith({\n        where: { id: { in: [\"e-1\", \"e-2\"] } },\n        data: { consumed: true },\n      });\n    });\n  });\n});\n","numLines":93,"startLine":1,"totalLines":93}}}
