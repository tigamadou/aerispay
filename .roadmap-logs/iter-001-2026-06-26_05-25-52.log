{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SESNzxLLV3HJBqhgpsH7sy","type":"tool_result","content":"1\t/**\n2\t * Lot E — M3 (RULE-NUM-001).\n3\t * Le numéro de vente provient d'un compteur transactionnel dédié (table Sequence),\n4\t * incrémenté atomiquement : unique, monotone, sans plafond annuel (pas de 99 999).\n5\t * Format documenté : VTE-YYYY-NNNNN (NNNNN = compteur, padStart 5 minimum).\n6\t */\n7\timport { describe, it, expect, vi, beforeEach } from \"vitest\";\n8\timport type { Role } from \"@prisma/client\";\n9\timport { Decimal } from \"@prisma/client/runtime/library\";\n10\t\n11\tvi.mock(\"@/lib/db\", () => ({\n12\t  prisma: {\n13\t    comptoirSession: { findUnique: vi.fn() },\n14\t    vente: { findFirst: vi.fn(), create: vi.fn(), findMany: vi.fn(), count: vi.fn() },\n15\t    produit: { findUnique: vi.fn(), update: vi.fn(), updateMany: vi.fn() },\n16\t    mouvementStock: { create: vi.fn() },\n17\t    caisse: { findFirst: vi.fn() },\n18\t    taxe: { findMany: vi.fn().mockResolvedValue([]) },\n19\t    sequence: { upsert: vi.fn() },\n20\t    $transaction: vi.fn(),\n21\t  },\n22\t}));\n23\t\n24\tvi.mock(\"@/auth\", () => ({ auth: vi.fn() }));\n25\tvi.mock(\"@/lib/activity-log\", () => ({\n26\t  logActivity: vi.fn(),\n27\t  ACTIONS: { SALE_COMPLETED: \"SALE_COMPLETED\" },\n28\t  getClientIp: vi.fn(),\n29\t  getClientUserAgent: vi.fn(),\n30\t}));\n31\tvi.mock(\"@/lib/services/cash-movement\", () => ({ createMovementInTx: vi.fn() }));\n32\t\n33\timport { prisma } from \"@/lib/db\";\n34\timport { auth } from \"@/auth\";\n35\t\n36\tfunction mockSession(role: Role, id = \"user-1\") {\n37\t  (auth as ReturnType<typeof vi.fn>).mockResolvedValue({ user: { id, email: \"t@t.com\", name: \"T\", role } });\n38\t}\n39\t\n40\tconst mockProduct = { id: \"p-1\", nom: \"T\", actif: true, stockActuel: 10, prixVente: new Decimal(1000), prixAchat: new Decimal(500) };\n41\tconst body = {\n42\t  sessionId: \"s-1\",\n43\t  lignes: [{ produitId: \"p-1\", quantite: 1, prixUnitaire: 1000, tva: 0, remise: 0 }],\n44\t  paiements: [{ mode: \"ESPECES\", montant: 1000 }],\n45\t  remise: 0,\n46\t};\n47\t\n48\tfunction setupTx(seqValeur: number, capture: { numero?: string }) {\n49\t  (prisma.$transaction as ReturnType<typeof vi.fn>).mockImplementation(async (fn: Function) => {\n50\t    const tx = {\n51\t      produit: { findUnique: vi.fn().mockResolvedValue(mockProduct), update: vi.fn(), updateMany: vi.fn().mockResolvedValue({ count: 1 }) },\n52\t      vente: {\n53\t        findFirst: vi.fn().mockResolvedValue(null),\n54\t        create: vi.fn().mockImplementation(async ({ data }: { data: { numero: string } }) => {\n55\t          capture.numero = data.numero;\n56\t          return {\n57\t            id: \"v\", numero: data.numero, total: new Decimal(1000), sousTotal: new Decimal(1000),\n58\t            remise: new Decimal(0), tva: new Decimal(0), sessionId: \"s-1\",\n59\t            lignes: [{ id: \"l\", produitId: \"p-1\", quantite: 1, prixUnitaire: new Decimal(1000), sousTotal: new Decimal(1000), produit: { nom: \"T\" } }],\n60\t            paiements: [{ mode: \"ESPECES\", montant: new Decimal(1000) }],\n61\t            caissier: { id: \"user-1\", nom: \"T\" },\n62\t          };\n63\t        }),\n64\t      },\n65\t      mouvementStock: { create: vi.fn() },\n66\t      sequence: { upsert: vi.fn().mockResolvedValue({ id: \"VTE-2026\", valeur: seqValeur }) },\n67\t    };\n68\t    return fn(tx);\n69\t  });\n70\t}\n71\t\n72\tdescribe(\"Lot E — numérotation via compteur Sequence\", () => {\n73\t  let POST: (req: Request) => Promise<Response>;\n74\t\n75\t  beforeEach(async () => {\n76\t    vi.clearAllMocks();\n77\t    POST = (await import(\"@/app/api/ventes/route\")).POST;\n78\t    (prisma.caisse.findFirst as ReturnType<typeof vi.fn>).mockResolvedValue({ id: \"caisse-1\" });\n79\t    (prisma.comptoirSession.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({ id: \"s-1\", statut: \"OUVERTE\" });\n80\t  });\n81\t\n82\t  function post() {\n83\t    return POST(new Request(\"http://localhost/api/ventes\", {\n84\t      method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body),\n85\t    }));\n86\t  }\n87\t\n88\t  it(\"utilise le compteur Sequence (upsert increment) pour le numéro\", async () => {\n89\t    mockSession(\"CAISSIER\");\n90\t    const cap: { numero?: string } = {};\n91\t    let upsertArgs: Record<string, unknown> | undefined;\n92\t    (prisma.$transaction as ReturnType<typeof vi.fn>).mockImplementation(async (fn: Function) => {\n93\t      const tx = {\n94\t        produit: { findUnique: vi.fn().mockResolvedValue(mockProduct), update: vi.fn(), updateMany: vi.fn().mockResolvedValue({ count: 1 }) },\n95\t        vente: { findFirst: vi.fn().mockResolvedValue(null), create: vi.fn().mockImplementation(async ({ data }: { data: { numero: string } }) => {\n96\t          cap.numero = data.numero;\n97\t          return { id: \"v\", numero: data.numero, total: new Decimal(1000), sousTotal: new Decimal(1000), remise: new Decimal(0), tva: new Decimal(0), sessionId: \"s-1\", lignes: [{ id: \"l\", produitId: \"p-1\", quantite: 1, prixUnitaire: new Decimal(1000), sousTotal: new Decimal(1000), produit: { nom: \"T\" } }], paiements: [{ mode: \"ESPECES\", montant: new Decimal(1000) }], caissier: { id: \"user-1\", nom: \"T\" } };\n98\t        }) },\n99\t        mouvementStock: { create: vi.fn() },\n100\t        sequence: { upsert: vi.fn().mockImplementation(async (args: Record<string, unknown>) => { upsertArgs = args; return { valeur: 7 }; }) },\n101\t      };\n102\t      return fn(tx);\n103\t    });\n104\t\n105\t    const res = await post();\n106\t    expect(res.status).toBe(201);\n107\t    expect(upsertArgs).toBeDefined();\n108\t    expect((upsertArgs as { update: { valeur: { increment: number } } }).update).toEqual({ valeur: { increment: 1 } });\n109\t    expect(cap.numero).toBe(\"VTE-2026-00007\");\n110\t  });\n111\t\n112\t  it(\"ne plafonne pas à 99 999 (au-delà, plus de 5 chiffres)\", async () => {\n113\t    mockSession(\"CAISSIER\");\n114\t    const cap: { numero?: string } = {};\n115\t    setupTx(100000, cap);\n116\t    const res = await post();\n117\t    expect(res.status).toBe(201);\n118\t    expect(cap.numero).toBe(\"VTE-2026-100000\");\n119\t  });\n120\t});\n121\t"}]},"parent_tool_use_id":null,"session_id":"90369130-3e16-4094-b146-2f36d5446af8","uuid":"d73b3280-130c-443d-8f23-cba704208377","timestamp":"2026-06-26T04:41:10.201Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/amadou/Devs/projects/aerispay/web/app/src/__tests__/ventes/numerotation-sequence.test.ts","content":"/**\n * Lot E — M3 (RULE-NUM-001).\n * Le numéro de vente provient d'un compteur transactionnel dédié (table Sequence),\n * incrémenté atomiquement : unique, monotone, sans plafond annuel (pas de 99 999).\n * Format documenté : VTE-YYYY-NNNNN (NNNNN = compteur, padStart 5 minimum).\n */\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\nimport type { Role } from \"@prisma/client\";\nimport { Decimal } from \"@prisma/client/runtime/library\";\n\nvi.mock(\"@/lib/db\", () => ({\n  prisma: {\n    comptoirSession: { findUnique: vi.fn() },\n    vente: { findFirst: vi.fn(), create: vi.fn(), findMany: vi.fn(), count: vi.fn() },\n    produit: { findUnique: vi.fn(), update: vi.fn(), updateMany: vi.fn() },\n    mouvementStock: { create: vi.fn() },\n    caisse: { findFirst: vi.fn() },\n    taxe: { findMany: vi.fn().mockResolvedValue([]) },\n    sequence: { upsert: vi.fn() },\n    $transaction: vi.fn(),\n  },\n}));\n\nvi.mock(\"@/auth\", () => ({ auth: vi.fn() }));\nvi.mock(\"@/lib/activity-log\", () => ({\n  logActivity: vi.fn(),\n  ACTIONS: { SALE_COMPLETED: \"SALE_COMPLETED\" },\n  getClientIp: vi.fn(),\n  getClientUserAgent: vi.fn(),\n}));\nvi.mock(\"@/lib/services/cash-movement\", () => ({ createMovementInTx: vi.fn() }));\n\nimport { prisma } from \"@/lib/db\";\nimport { auth } from \"@/auth\";\n\nfunction mockSession(role: Role, id = \"user-1\") {\n  (auth as ReturnType<typeof vi.fn>).mockResolvedValue({ user: { id, email: \"t@t.com\", name: \"T\", role } });\n}\n\nconst mockProduct = { id: \"p-1\", nom: \"T\", actif: true, stockActuel: 10, prixVente: new Decimal(1000), prixAchat: new Decimal(500) };\nconst body = {\n  sessionId: \"s-1\",\n  lignes: [{ produitId: \"p-1\", quantite: 1, prixUnitaire: 1000, tva: 0, remise: 0 }],\n  paiements: [{ mode: \"ESPECES\", montant: 1000 }],\n  remise: 0,\n};\n\nfunction setupTx(seqValeur: number, capture: { numero?: string }) {\n  (prisma.$transaction as ReturnType<typeof vi.fn>).mockImplementation(async (fn: Function) => {\n    const tx = {\n      produit: { findUnique: vi.fn().mockResolvedValue(mockProduct), update: vi.fn(), updateMany: vi.fn().mockResolvedValue({ count: 1 }) },\n      vente: {\n        findFirst: vi.fn().mockResolvedValue(null),\n        create: vi.fn().mockImplementation(async ({ data }: { data: { numero: string } }) => {\n          capture.numero = data.numero;\n          return {\n            id: \"v\", numero: data.numero, total: new Decimal(1000), sousTotal: new Decimal(1000),\n            remise: new Decimal(0), tva: new Decimal(0), sessionId: \"s-1\",\n            lignes: [{ id: \"l\", produitId: \"p-1\", quantite: 1, prixUnitaire: new Decimal(1000), sousTotal: new Decimal(1000), produit: { nom: \"T\" } }],\n            paiements: [{ mode: \"ESPECES\", montant: new Decimal(1000) }],\n            caissier: { id: \"user-1\", nom: \"T\" },\n          };\n        }),\n      },\n      mouvementStock: { create: vi.fn() },\n      sequence: { upsert: vi.fn().mockResolvedValue({ id: \"VTE-2026\", valeur: seqValeur }) },\n    };\n    return fn(tx);\n  });\n}\n\ndescribe(\"Lot E — numérotation via compteur Sequence\", () => {\n  let POST: (req: Request) => Promise<Response>;\n\n  beforeEach(async () => {\n    vi.clearAllMocks();\n    POST = (await import(\"@/app/api/ventes/route\")).POST;\n    (prisma.caisse.findFirst as ReturnType<typeof vi.fn>).mockResolvedValue({ id: \"caisse-1\" });\n    (prisma.comptoirSession.findUnique as ReturnType<typeof vi.fn>).mockResolvedValue({ id: \"s-1\", statut: \"OUVERTE\" });\n  });\n\n  function post() {\n    return POST(new Request(\"http://localhost/api/ventes\", {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(body),\n    }));\n  }\n\n  it(\"utilise le compteur Sequence (upsert increment) pour le numéro\", async () => {\n    mockSession(\"CAISSIER\");\n    const cap: { numero?: string } = {};\n    let upsertArgs: Record<string, unknown> | undefined;\n    (prisma.$transaction as ReturnType<typeof vi.fn>).mockImplementation(async (fn: Function) => {\n      const tx = {\n        produit: { findUnique: vi.fn().mockResolvedValue(mockProduct), update: vi.fn(), updateMany: vi.fn().mockResolvedValue({ count: 1 }) },\n        vente: { findFirst: vi.fn().mockResolvedValue(null), create: vi.fn().mockImplementation(async ({ data }: { data: { numero: string } }) => {\n          cap.numero = data.numero;\n          return { id: \"v\", numero: data.numero, total: new Decimal(1000), sousTotal: new Decimal(1000), remise: new Decimal(0), tva: new Decimal(0), sessionId: \"s-1\", lignes: [{ id: \"l\", produitId: \"p-1\", quantite: 1, prixUnitaire: new Decimal(1000), sousTotal: new Decimal(1000), produit: { nom: \"T\" } }], paiements: [{ mode: \"ESPECES\", montant: new Decimal(1000) }], caissier: { id: \"user-1\", nom: \"T\" } };\n        }) },\n        mouvementStock: { create: vi.fn() },\n        sequence: { upsert: vi.fn().mockImplementation(async (args: Record<string, unknown>) => { upsertArgs = args; return { valeur: 7 }; }) },\n      };\n      return fn(tx);\n    });\n\n    const res = await post();\n    expect(res.status).toBe(201);\n    expect(upsertArgs).toBeDefined();\n    expect((upsertArgs as { update: { valeur: { increment: number } } }).update).toEqual({ valeur: { increment: 1 } });\n    expect(cap.numero).toBe(\"VTE-2026-00007\");\n  });\n\n  it(\"ne plafonne pas à 99 999 (au-delà, plus de 5 chiffres)\", async () => {\n    mockSession(\"CAISSIER\");\n    const cap: { numero?: string } = {};\n    setupTx(100000, cap);\n    const res = await post();\n    expect(res.status).toBe(201);\n    expect(cap.numero).toBe(\"VTE-2026-100000\");\n  });\n});\n","numLines":121,"startLine":1,"totalLines":121}}}
