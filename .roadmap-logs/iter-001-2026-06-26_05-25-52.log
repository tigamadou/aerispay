ry {\n    const body = await req.json();\n    const parsed = caisseSchema.safeParse(body);\n    if (!parsed.success) {\n      return Response.json(\n        { error: \"Données invalides\", details: parsed.error.flatten() },\n        { status: 400 }\n      );\n    }\n\n    const caisse = await prisma.caisse.create({\n      data: { nom: parsed.data.nom, active: parsed.data.active ?? true },\n    });\n\n    await logActivity({\n      action: ACTIONS.CAISSE_CREATED,\n      actorId: result.user.id,\n      entityType: \"Caisse\",\n      entityId: caisse.id,\n      metadata: { nom: caisse.nom },\n      ipAddress: getClientIp(req),\n      userAgent: getClientUserAgent(req),\n    });\n\n    return Response.json({ data: caisse }, { status: 201 });\n  } catch (error) {\n    console.error(\"[POST /api/caisse]\", error);\n    return Response.json({ error: \"Erreur serveur\" }, { status: 500 });\n  }\n}\n","structuredPatch":[{"oldStart":4,"oldLines":6,"newStart":4,"newLines":7,"lines":[" import { logActivity, ACTIONS, getClientIp, getClientUserAgent } from \"@/lib/activity-log\";"," "," const caisseSchema = z.object({","+  code: z.string().min(1).max(20),","   nom: z.string().min(1).max(100),","   active: z.boolean().optional(),"," });"]}],"userModified":false,"replaceAll":false}}
