{
  "name": "aerispay-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Client caisse Electron AerisPay — coquille kiosque + pont périphériques (sans base de données).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "test": "vitest run",
    "rebuild:native": "electron-rebuild -f -w node-thermal-printer,serialport",
    "dist": "npm run build && electron-builder",
    "dist:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "node-thermal-printer": "^4.4.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.2.1",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  }
}
